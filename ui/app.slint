import { Theme } from "./theme.slint";
import { TopNavButton, ButtonChip } from "./components/primitives.slint";
import { Icon } from "./components/icons.slint";
import { ToastView } from "./components/toast.slint";
import { LoadingPage } from "./pages/loading.slint";
import { SplashPage } from "./pages/splash.slint";
import { CodePage } from "./pages/code.slint";
import { FilesPage } from "./pages/files.slint";
import { SettingsPage } from "./pages/settings.slint";
import { TransfersPage } from "./pages/transfers.slint";
import { MediaPage, MediaItem } from "./pages/media.slint";
import { TvShowPage } from "./pages/tvshow.slint";
import { PlayerPage } from "./pages/player.slint";
import { MagnetsPage } from "./pages/magnets.slint";
import { FileItem, MetadataItem, PathSegment, LocalDataRow, PlayerPlaylistItem, PlayerTrack, TransferItem, MagnetItem, TvSeasonTab, TvEpisodeRow, TvCreatorChip, TvHeroBadge, TvDetailItem } from "./types.slint";

export component AppWindow inherits Window {
    title: "PutMPV";
    icon: @image-url("./assets/appicon-titlebar.png");
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 680px;
    resize-border-width: 8px;
    background: Theme.bg;
    default-font-family: Theme.ui_font;
    default-font-size: 13px;

    in-out property <string> app_version;
    in-out property <int> view: 0;
    in-out property <string> loading_message: "Checking sign-in…";
    in-out property <string> device_code: "";
    in-out property <string> device_expires: "10:00";
    in-out property <string> device_link: "https://put.io/link";
    in-out property <string> oauth_error: "";
    in-out property <string> files_query;
    in-out property <int> files_mode: 0;
    in-out property <int> files_sort: 0;
    in-out property <bool> files_sort_descending: true;
    in-out property <[FileItem]> visible_items;
    in-out property <[PathSegment]> path_segments;
    in-out property <bool> has_parent: false;
    in-out property <int> folder_count: 0;
    in-out property <int> file_count: 0;
    in-out property <string> total_label: "";
    in-out property <bool> detail_open: false;
    in-out property <FileItem> detail_item;
    in-out property <[MetadataItem]> metadata_items;
    in-out property <string> metadata_query;
    in-out property <int> metadata_filter: 0;
    in-out property <bool> metadata_hide_matched: false;
    in-out property <int> metadata_total_count: 0;
    in-out property <int> metadata_selected_count: 0;
    in-out property <int> metadata_unmatched_count: 0;
    in-out property <int> metadata_tv_count: 0;
    in-out property <int> metadata_movie_count: 0;
    in-out property <string> metadata_status;
    in-out property <bool> metadata_busy: false;
    in-out property <bool> auto_metadata_fetch_enabled: false;
    in-out property <int> settings_section: 0;
    in-out property <string> tmdb_local_key;
    in-out property <string> tmdb_putio_key;
    in-out property <int> tmdb_source: 0;
    in-out property <string> tmdb_status;
    in-out property <[string]> sync_profile_labels;
    in-out property <int> sync_existing_index: -1;
    in-out property <string> sync_new_name;
    in-out property <string> sync_status;
    in-out property <int> sync_played_count: 0;
    in-out property <int> sync_known_count: 0;
    in-out property <string> sync_active_profile;
    in-out property <image> player_texture;
    in-out property <string> player_title;
    in-out property <float> player_texture_width: self.width / 1phx;
    in-out property <float> player_texture_height: (self.height - (root.view == 7 ? 0px : Theme.title_bar_height)) / 1phx;
    in-out property <bool> player_paused: true;
    in-out property <float> player_position: 0;
    in-out property <float> player_duration: 0;
    in-out property <float> player_buffered_fraction: 0;
    in-out property <string> player_position_label: "0:00";
    in-out property <string> player_duration_label: "0:00";
    in-out property <float> player_volume: 80;
    in-out property <bool> player_muted: false;
    in-out property <[PlayerTrack]> player_subtitle_tracks;
    in-out property <string> player_selected_subtitle: "";
    in-out property <[PlayerTrack]> player_audio_tracks;
    in-out property <string> player_selected_audio: "";
    in-out property <[PlayerPlaylistItem]> player_playlist_items;
    in-out property <string> player_playlist_current_id: "";
    in-out property <bool> player_playlist_has_previous: false;
    in-out property <bool> player_playlist_has_next: false;
    in-out property <string> player_subtitle_text: "";
    in-out property <int> player_subtitle_render_mode: 0;
    in-out property <bool> player_fullscreen: false;
    in-out property <[LocalDataRow]> local_data_rows;
    in-out property <bool> confirm_open: false;
    in-out property <string> local_data_status;
    in-out property <[MediaItem]> media_movies;
    in-out property <[MediaItem]> media_shows;
    in-out property <bool> media_has_unmatched: false;
    in-out property <string> media_unmatched_title;
    in-out property <string> media_unmatched_detail;
    in-out property <bool> media_show_error_flash: false;
    in-out property <string> media_error_flash_text;
    in-out property <bool> media_show_success_flash: false;
    in-out property <string> media_success_flash_text;
    in-out property <bool> transfers_add_open: false;
    in-out property <string> transfers_magnet: "";
    in-out property <[TransferItem]> transfers_items;
    in-out property <bool> transfers_busy: false;
    in-out property <string> transfers_status: "";
    in-out property <string> transfers_count_label: "0 transfers";
    in-out property <bool> transfers_cancel_confirm_open: false;
    in-out property <string> transfers_cancel_name: "";
    in-out property <[MagnetItem]> magnets_items;
    in-out property <string> magnets_query: "";
    in-out property <bool> magnets_busy: false;
    in-out property <string> magnets_status: "";
    in-out property <string> magnets_count_label: "0 results";
    in-out property <int> magnets_sort_index: 1;
    in-out property <bool> magnets_sort_descending: true;
    in-out property <bool> magnets_f720p: false;
    in-out property <bool> magnets_f1080p: false;
    in-out property <bool> magnets_f2160p: false;
    in-out property <bool> magnets_fx264: false;
    in-out property <bool> magnets_fx265: false;
    in-out property <bool> magnets_fhdr: false;
    in-out property <bool> toast_visible: false;
    in-out property <int> toast_kind: 0;
    in-out property <string> toast_title: "";
    in-out property <string> toast_body: "";
    in-out property <string> toast_action_label: "";
    in-out property <string> latest_version: "";
    in-out property <string> update_status: "Check for updates to compare this build with the latest GitHub release.";
    in-out property <bool> update_busy: false;
    in-out property <bool> update_available: false;
    in-out property <string> update_action_label: "Download";
    in-out property <bool> update_action_enabled: false;
    in-out property <bool> update_install_supported: false;

    in-out property <string> tv_show_title: "";
    in-out property <string> tv_show_tagline: "";
    in-out property <string> tv_show_rating_label: "";
    in-out property <string> tv_show_years_label: "";
    in-out property <string> tv_show_overview: "";
    in-out property <string> tv_show_stats_line: "";
    in-out property <[TvHeroBadge]> tv_show_hero_badges;
    in-out property <bool> tv_show_has_hero_badges: false;
    in-out property <image> tv_show_backdrop;
    in-out property <image> tv_show_hero_poster;
    in-out property <bool> tv_show_series_details_visible: false;
    in-out property <[TvDetailItem]> tv_show_detail_items;
    in-out property <string> tv_show_first_file_id: "";
    in-out property <[TvSeasonTab]> tv_show_seasons;
    in-out property <int> tv_show_season_idx: 0;
    in-out property <string> tv_show_season_block_title: "";
    in-out property <string> tv_show_season_block_meta: "";
    in-out property <string> tv_show_season_block_overview: "";
    in-out property <image> tv_show_season_block_poster;
    in-out property <[TvEpisodeRow]> tv_show_episodes;
    in-out property <int> tv_show_series_id: 0;

    callback sign_in();
    callback code_back();
    callback code_open_link();
    callback code_copy();
    callback code_continue();
    callback logout();
    callback files_open_item(id: int, item_type: string);
    callback files_go_up();
    callback files_go_root();
    callback files_go_to_path(index: int);
    callback files_sort_changed(index: int);
    callback files_mode_changed(index: int);
    callback files_sort_direction_toggled();
    callback files_query_changed();
    callback files_refresh();
    callback files_close_detail();
    callback files_menu_action(action: string, id: int);
    callback files_context_menu_action(action: string);
    callback metadata_toggle_item(id: int);
    callback metadata_toggle_expand(id: int);
    callback metadata_select_unmatched();
    callback metadata_clear_selection();
    callback metadata_fetch();
    callback metadata_criteria_changed();
    callback auto_metadata_fetch_changed(bool);
    callback auto_metadata_fetch_after_refresh();
    callback request_refresh();
    callback settings_refresh();
    callback tmdb_source_changed(source: int);
    callback tmdb_save_local();
    callback tmdb_replace_putio();
    callback tmdb_delete_putio();
    callback sync_profile_selected(index: int);
    callback sync_refresh_profiles();
    callback sync_use_existing();
    callback sync_use_new();
    callback sync_now();
    callback sync_disable();
    callback player_close();
    callback player_toggle_play();
    callback player_seek(seconds: float);
    callback player_set_volume(volume: float);
    callback player_toggle_mute();
    callback player_select_subtitle(track_id: string);
    callback player_toggle_captions();
    callback player_subtitle_render_mode_changed(mode: int);
    callback player_select_audio(track_id: string);
    callback player_playlist_play(file_id: string);
    callback player_playlist_previous();
    callback player_playlist_next();
    callback player_toggle_fullscreen();
    callback player_exit_fullscreen();
    callback local_data_clear(index: int);
    callback local_data_confirm_clear();
    callback local_data_cancel_clear();
    callback media_refresh();
    callback media_item_clicked(file_id: string);
    callback media_watch_toggle(file_id: string);
    callback media_scrape_unmatched();
    callback media_dismiss_error();
    callback media_dismiss_success();
    callback transfers_open_add();
    callback transfers_close_add();
    callback transfers_submit_magnet();
    callback transfers_pick_torrent_file();
    callback transfers_refresh();
    callback transfers_reannounce(id: string);
    callback transfers_cancel_requested(id: string, name: string);
    callback transfers_cancel_confirm();
    callback transfers_cancel_dismiss();
    callback transfers_clear_completed();
    callback transfers_go_to_file(file_id: string, parent_id: string);
    callback magnets_search();
    callback magnets_copy(magnet: string);
    callback magnets_download(magnet: string);
    callback magnets_filter_changed();
    callback magnets_sort_changed(index: int);
    callback magnets_sort_direction_toggled();
    callback updates_check();
    callback updates_install();
    callback tv_show_back();
    callback tv_show_season_changed(int);
    callback tv_show_play_episode(string);
    callback tv_show_episode_subtitles(string);
    callback tv_show_episode_watch_toggle(string);

    public function show_toast(kind: int, title: string, body: string) {
        root.toast_kind = kind;
        root.toast_title = title;
        root.toast_body = body;
        root.toast_action_label = "";
        root.toast_visible = true;
        toast-timer.restart();
    }

    public function show_toast_action(kind: int, title: string, body: string, action_label: string) {
        root.toast_kind = kind;
        root.toast_title = title;
        root.toast_body = body;
        root.toast_action_label = action_label;
        root.toast_visible = true;
        toast-timer.restart();
    }

    public function dismiss_toast() {
        root.toast_visible = false;
        toast-timer.stop();
    }

    toast-timer := Timer {
        interval: 3500ms;
        running: false;
        triggered => {
            root.toast_visible = false;
            toast-timer.running = false;
        }
    }

    if (root.view != 7) : title-bar := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: Theme.title_bar_height;
        background: Theme.bg;

        Icon {
            x: 18px;
            y: 14px;
            name: "putmpv";
            icon_size: 24px;
        }

        Text {
            x: 50px;
            y: 17px;
            text: "PutMPV";
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            font-family: Theme.ui_font;
        }

        if (root.view >= 3 && root.view != 7) : top-nav := HorizontalLayout {
            x: parent.width - self.width - 18px;
            y: 9px;
            width: self.preferred-width;
            height: 34px;
            spacing: 6px;
            alignment: end;

            TopNavButton { label: "Files"; icon_name: "folder"; active: root.view == 3; clicked => { root.view = 3; } }
            TopNavButton { label: "Transfers"; icon_name: "download"; active: root.view == 5; clicked => { root.view = 5; root.transfers_refresh(); } }
            TopNavButton { label: "Media"; icon_name: "media"; active: root.view == 4 || root.view == 8; clicked => { root.view = 4; root.media_refresh(); } }
            TopNavButton { label: "Magnets"; icon_name: "magnet"; active: root.view == 9; clicked => { root.view = 9; } }
            TopNavButton { label: "Settings"; icon_name: "settings"; active: root.view == 6; clicked => { root.view = 6; root.settings_refresh(); if (root.settings_section == 1) { root.sync_refresh_profiles(); } if (root.settings_section == 3) { root.metadata_criteria_changed(); } } }
            Rectangle { width: 13px; Rectangle { x: 6px; y: (parent.height - self.height) / 2; width: 1px; height: 20px; background: Theme.border; } }
            ButtonChip { label: "Logout"; icon_name: "logout"; clicked => { root.logout(); } }
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }

    if (root.view == 0) : loading := LoadingPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        message: root.loading_message;
    }

    if (root.view == 1) : splash := SplashPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        sign_in => { root.sign_in(); }
    }

    if (root.view == 2) : code := CodePage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        code: root.device_code;
        expires: root.device_expires;
        back => { root.code_back(); }
        open_link => { root.code_open_link(); }
        copy_code => { root.code_copy(); }
        continue_to_files => { root.code_continue(); }
    }

    if (root.view == 3) : files := FilesPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        items: root.visible_items;
        path_segments: root.path_segments;
        has_parent: root.has_parent;
        folder_count: root.folder_count;
        file_count: root.file_count;
        total_label: root.total_label;
        detail_open: root.detail_open;
        detail_item: root.detail_item;
        query <=> root.files_query;
        mode <=> root.files_mode;
        sort_index <=> root.files_sort;
        sort_descending <=> root.files_sort_descending;
        open_item(id, item_type) => { root.files_open_item(id, item_type); }
        go_up => { root.files_go_up(); }
        go_root => { root.files_go_root(); }
        go_to_path(index) => { root.files_go_to_path(index); }
        set_sort(index) => { root.files_sort_changed(index); }
        set_mode(index) => { root.files_mode_changed(index); }
        toggle_sort_direction => { root.files_sort_direction_toggled(); }
        query_changed => { root.files_query_changed(); }
        refresh_requested => { root.files_refresh(); }
        close_detail => { root.files_close_detail(); }
        menu_action(action, id) => { root.files_menu_action(action, id); }
        context_menu_action(action) => { root.files_context_menu_action(action); }
        play_item(id) => { root.files_menu_action("play", id); }
    }

    if (root.view == 4) : media := MediaPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        movies: root.media_movies;
        shows: root.media_shows;
        has_unmatched: root.media_has_unmatched;
        unmatched_title: root.media_unmatched_title;
        unmatched_detail: root.media_unmatched_detail;
        show_error_flash: root.media_show_error_flash;
        error_flash_text: root.media_error_flash_text;
        show_success_flash: root.media_show_success_flash;
        success_flash_text: root.media_success_flash_text;
        scrape_unmatched => { root.media_scrape_unmatched(); }
        dismiss_error => { root.media_dismiss_error(); }
        dismiss_success => { root.media_dismiss_success(); }
        media_item_clicked(file_id) => { root.media_item_clicked(file_id); }
        media_watch_toggle(file_id) => { root.media_watch_toggle(file_id); }
    }

    if (root.view == 5) : transfers := TransfersPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        add_open <=> root.transfers_add_open;
        magnet <=> root.transfers_magnet;
        items: root.transfers_items;
        busy: root.transfers_busy;
        status: root.transfers_status;
        count_label: root.transfers_count_label;
        cancel_confirm_open <=> root.transfers_cancel_confirm_open;
        cancel_name: root.transfers_cancel_name;
        open_add => { root.transfers_open_add(); }
        close_add => { root.transfers_close_add(); }
        submit_magnet => { root.transfers_submit_magnet(); }
        pick_torrent_file => { root.transfers_pick_torrent_file(); }
        refresh => { root.transfers_refresh(); }
        reannounce(id) => { root.transfers_reannounce(id); }
        cancel_requested(id, name) => { root.transfers_cancel_requested(id, name); }
        cancel_confirm => { root.transfers_cancel_confirm(); }
        cancel_dismiss => { root.transfers_cancel_dismiss(); }
        clear_completed => { root.transfers_clear_completed(); }
        go_to_file(file_id, parent_id) => { root.transfers_go_to_file(file_id, parent_id); }
    }

    if (root.view == 9) : magnets := MagnetsPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        items: root.magnets_items;
        search_text <=> root.magnets_query;
        busy: root.magnets_busy;
        status: root.magnets_status;
        count_label: root.magnets_count_label;
        sort_index <=> root.magnets_sort_index;
        sort_descending <=> root.magnets_sort_descending;
        f720p <=> root.magnets_f720p;
        f1080p <=> root.magnets_f1080p;
        f2160p <=> root.magnets_f2160p;
        fx264 <=> root.magnets_fx264;
        fx265 <=> root.magnets_fx265;
        fhdr <=> root.magnets_fhdr;
        search_submit => { root.magnets_search(); }
        copy_magnet(m) => { root.magnets_copy(m); }
        download(m) => { root.magnets_download(m); }
        toggle_filter(name) => { root.magnets_filter_changed(); }
        sort_changed(idx) => { root.magnets_sort_changed(idx); }
        sort_direction_toggled => { root.magnets_sort_direction_toggled(); }
    }

    if (root.view == 8) : tvshow := TvShowPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        title: root.tv_show_title;
        tagline: root.tv_show_tagline;
        rating_label: root.tv_show_rating_label;
        years_label: root.tv_show_years_label;
        overview: root.tv_show_overview;
        stats_line: root.tv_show_stats_line;
        hero_badges: root.tv_show_hero_badges;
        has_hero_badges: root.tv_show_has_hero_badges;
        backdrop: root.tv_show_backdrop;
        hero_poster: root.tv_show_hero_poster;
        series_details_visible: root.tv_show_series_details_visible;
        detail_items: root.tv_show_detail_items;
        first_file_id: root.tv_show_first_file_id;
        seasons: root.tv_show_seasons;
        selected_season_idx <=> root.tv_show_season_idx;
        season_block_title: root.tv_show_season_block_title;
        season_block_meta: root.tv_show_season_block_meta;
        season_block_overview: root.tv_show_season_block_overview;
        season_block_poster: root.tv_show_season_block_poster;
        episodes: root.tv_show_episodes;
        back_clicked => { root.tv_show_back(); }
        season_changed(idx) => { root.tv_show_season_changed(idx); }
        play_episode(file_id) => { root.tv_show_play_episode(file_id); }
        subtitles_clicked(file_id) => { root.tv_show_episode_subtitles(file_id); }
        episode_watch_toggle(file_id) => { root.tv_show_episode_watch_toggle(file_id); }
    }

    if (root.view == 7) : player := PlayerPage {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        texture <=> root.player_texture;
        title <=> root.player_title;
        paused <=> root.player_paused;
        position <=> root.player_position;
        duration <=> root.player_duration;
        buffered_fraction <=> root.player_buffered_fraction;
        position_label <=> root.player_position_label;
        duration_label <=> root.player_duration_label;
        volume <=> root.player_volume;
        muted <=> root.player_muted;
        subtitle_tracks <=> root.player_subtitle_tracks;
        selected_subtitle <=> root.player_selected_subtitle;
        audio_tracks <=> root.player_audio_tracks;
        selected_audio <=> root.player_selected_audio;
        playlist_items <=> root.player_playlist_items;
        playlist_current_id <=> root.player_playlist_current_id;
        playlist_has_previous <=> root.player_playlist_has_previous;
        playlist_has_next <=> root.player_playlist_has_next;
        subtitle_text <=> root.player_subtitle_text;
        subtitle_render_mode <=> root.player_subtitle_render_mode;
        fullscreen <=> root.player_fullscreen;
        close => { root.player_close(); }
        toggle_play => { root.player_toggle_play(); }
        seek(seconds) => { root.player_seek(seconds); }
        set_volume(volume) => { root.player_set_volume(volume); }
        toggle_mute => { root.player_toggle_mute(); }
        select_subtitle(track_id) => { root.player_select_subtitle(track_id); }
        toggle_captions => { root.player_toggle_captions(); }
        subtitle_render_mode_changed(mode) => { root.player_subtitle_render_mode_changed(mode); }
        select_audio(track_id) => { root.player_select_audio(track_id); }
        playlist_play(file_id) => { root.player_playlist_play(file_id); }
        playlist_previous => { root.player_playlist_previous(); }
        playlist_next => { root.player_playlist_next(); }
        toggle_fullscreen => { root.player_toggle_fullscreen(); }
        exit_fullscreen => { root.player_exit_fullscreen(); }
    }

    if (root.view == 6) : settings := SettingsPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        app_version: root.app_version;
        section <=> root.settings_section;
        tmdb_local_key <=> root.tmdb_local_key;
        tmdb_putio_key <=> root.tmdb_putio_key;
        tmdb_source <=> root.tmdb_source;
        tmdb_status <=> root.tmdb_status;
        sync_profile_labels <=> root.sync_profile_labels;
        sync_existing_index <=> root.sync_existing_index;
        sync_new_name <=> root.sync_new_name;
        sync_status <=> root.sync_status;
        sync_played_count <=> root.sync_played_count;
        sync_known_count <=> root.sync_known_count;
        sync_active_profile <=> root.sync_active_profile;
        local_data_rows: root.local_data_rows;
        confirm_open <=> root.confirm_open;
        local_data_status <=> root.local_data_status;
        metadata_items: root.metadata_items;
        metadata_query <=> root.metadata_query;
        metadata_filter_index <=> root.metadata_filter;
        metadata_hide_matched <=> root.metadata_hide_matched;
        metadata_total_count: root.metadata_total_count;
        metadata_selected_count: root.metadata_selected_count;
        metadata_unmatched_count: root.metadata_unmatched_count;
        metadata_tv_count: root.metadata_tv_count;
        metadata_movie_count: root.metadata_movie_count;
        metadata_status: root.metadata_status;
        metadata_busy: root.metadata_busy;
        auto_metadata_fetch_enabled: root.auto_metadata_fetch_enabled;
        latest_version: root.latest_version;
        update_status: root.update_status;
        update_busy: root.update_busy;
        update_available: root.update_available;
        update_action_label: root.update_action_label;
        update_action_enabled: root.update_action_enabled;
        update_install_supported: root.update_install_supported;
        settings_refresh => { root.settings_refresh(); }
        tmdb_source_changed(source) => { root.tmdb_source_changed(source); }
        tmdb_save_local => { root.tmdb_save_local(); }
        tmdb_replace_putio => { root.tmdb_replace_putio(); }
        tmdb_delete_putio => { root.tmdb_delete_putio(); }
        sync_profile_selected(index) => { root.sync_profile_selected(index); }
        sync_refresh_profiles => { root.sync_refresh_profiles(); }
        sync_use_existing => { root.sync_use_existing(); }
        sync_use_new => { root.sync_use_new(); }
        sync_now => { root.sync_now(); }
        sync_disable => { root.sync_disable(); }
        local_data_clear(index) => { root.local_data_clear(index); }
        local_data_confirm_clear => { root.local_data_confirm_clear(); }
        local_data_cancel_clear => { root.local_data_cancel_clear(); }
        metadata_toggle_item(id) => { root.metadata_toggle_item(id); }
        metadata_toggle_expand(id) => { root.metadata_toggle_expand(id); }
        metadata_select_unmatched => { root.metadata_select_unmatched(); }
        metadata_clear_selection => { root.metadata_clear_selection(); }
        metadata_fetch => { root.metadata_fetch(); }
        metadata_criteria_changed => { root.metadata_criteria_changed(); }
        auto_metadata_fetch_changed(enabled) => { root.auto_metadata_fetch_changed(enabled); }
        updates_check => { root.updates_check(); }
        updates_install => { root.updates_install(); }
    }

    if (root.toast_visible && root.view != 7) : toast := ToastView {
        width: min(parent.width - 36px, 440px);
        x: 18px;
        y: parent.height - self.height - 18px;
        kind: root.toast_kind;
        title: root.toast_title;
        body: root.toast_body;
        action_label: root.toast_action_label;
        dismissed => { root.dismiss_toast(); }
        action_clicked => {
            root.dismiss_toast();
            root.view = 6;
            root.settings_section = 4;
        }
    }
}
