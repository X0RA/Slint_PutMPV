import { Theme } from "./theme.slint";
import { TopNavButton, ButtonChip } from "./components/primitives.slint";
import { LogoMark } from "./components/icons.slint";
import { LoadingPage } from "./pages/loading.slint";
import { SplashPage } from "./pages/splash.slint";
import { CodePage } from "./pages/code.slint";
import { FilesPage } from "./pages/files.slint";
import { MetadataPage } from "./pages/metadata.slint";
import { SettingsPage } from "./pages/settings.slint";
import { MediaPage } from "./pages/media.slint";
import { PlayerPage } from "./pages/player.slint";
import { FileItem, MetadataItem, PathSegment, LocalDataRow } from "./types.slint";

export component AppWindow inherits Window {
    title: "PutMPV";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 680px;
    no-frame: true;
    resize-border-width: 8px;
    background: Theme.bg;
    default-font-family: Theme.ui_font;
    default-font-size: 13px;

    in-out property <int> view: 0;
    in-out property <string> loading_message: "Checking sign-in…";
    in-out property <string> device_code: "";
    in-out property <string> device_expires: "10:00";
    in-out property <string> device_link: "https://put.io/link";
    in-out property <string> oauth_error: "";
    in-out property <string> files_query;
    in-out property <int> files_mode: 0;
    in-out property <int> files_sort: 0;
    in-out property <bool> files_sort_descending: true;
    in-out property <[FileItem]> visible_items;
    in-out property <[PathSegment]> path_segments;
    in-out property <bool> has_parent: false;
    in-out property <int> folder_count: 0;
    in-out property <int> file_count: 0;
    in-out property <string> total_label: "";
    in-out property <bool> detail_open: false;
    in-out property <FileItem> detail_item;
    in-out property <[MetadataItem]> metadata_items;
    in-out property <string> metadata_query;
    in-out property <int> metadata_filter: 0;
    in-out property <bool> metadata_hide_matched: false;
    in-out property <int> metadata_total_count: 0;
    in-out property <int> metadata_selected_count: 0;
    in-out property <int> metadata_unmatched_count: 0;
    in-out property <int> metadata_tv_count: 0;
    in-out property <int> metadata_movie_count: 0;
    in-out property <string> metadata_status;
    in-out property <bool> metadata_busy: false;
    in-out property <int> settings_section: 0;
    in-out property <string> tmdb_local_key;
    in-out property <string> tmdb_putio_key;
    in-out property <int> tmdb_source: 0;
    in-out property <string> tmdb_status;
    in-out property <[string]> sync_profile_labels;
    in-out property <int> sync_existing_index: -1;
    in-out property <string> sync_new_name;
    in-out property <string> sync_status;
    in-out property <int> sync_played_count: 0;
    in-out property <int> sync_known_count: 0;
    in-out property <string> sync_active_profile;
    in-out property <int> mpv_source: 0;
    in-out property <string> mpv_active_path;
    in-out property <string> mpv_system_path;
    in-out property <string> mpv_custom_path;
    in-out property <string> mpv_managed_path;
    in-out property <bool> mpv_system_available: false;
    in-out property <bool> mpv_custom_available: false;
    in-out property <bool> mpv_managed_available: false;
    in-out property <bool> mpv_show_managed: false;
    in-out property <string> mpv_install_hint;
    in-out property <bool> mpv_can_open_install_link: false;
    in-out property <image> player_texture;
    in-out property <string> player_title;
    in-out property <float> player_texture_width: self.width / 1phx;
    in-out property <float> player_texture_height: (self.height - Theme.title_bar_height) / 1phx;
    in-out property <[LocalDataRow]> local_data_rows;
    in-out property <bool> confirm_open: false;
    in-out property <string> local_data_status;

    callback sign_in();
    callback code_back();
    callback code_open_link();
    callback code_copy();
    callback code_continue();
    callback logout();
    callback files_open_item(id: int, item_type: string);
    callback files_go_up();
    callback files_go_root();
    callback files_go_to_path(index: int);
    callback files_sort_changed(index: int);
    callback files_mode_changed(index: int);
    callback files_sort_direction_toggled();
    callback files_query_changed();
    callback files_close_detail();
    callback files_menu_action(action: string, id: int);
    callback metadata_toggle_item(id: int);
    callback metadata_toggle_expand(id: int);
    callback metadata_select_unmatched();
    callback metadata_clear_selection();
    callback metadata_fetch();
    callback metadata_criteria_changed();
    callback request_refresh();
    callback settings_refresh();
    callback tmdb_source_changed(source: int);
    callback tmdb_save_local();
    callback tmdb_replace_putio();
    callback tmdb_delete_putio();
    callback sync_profile_selected(index: int);
    callback sync_refresh_profiles();
    callback sync_use_existing();
    callback sync_use_new();
    callback sync_now();
    callback sync_disable();
    callback mpv_source_changed(source: int);
    callback mpv_custom_path_edited();
    callback mpv_browse_custom();
    callback mpv_open_install_link();
    callback player_close();
    callback local_data_clear(index: int);
    callback local_data_confirm_clear();
    callback local_data_cancel_clear();

    title-bar := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: Theme.title_bar_height;
        background: Theme.bg;

        LogoMark {
            x: 18px;
            y: 14px;
        }

        Text {
            x: 50px;
            y: 17px;
            text: "PutMPV";
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            font-family: Theme.ui_font;
        }

        if (root.view >= 3 && root.view != 7) : top-nav := HorizontalLayout {
            x: parent.width - self.width - 18px;
            y: 9px;
            width: self.preferred-width;
            height: 34px;
            spacing: 6px;
            alignment: end;

            TopNavButton { label: "Files"; icon_name: "folder"; active: root.view == 3; clicked => { root.view = 3; } }
            TopNavButton { label: "Media"; icon_name: "media"; active: root.view == 4; clicked => { root.view = 4; } }
            TopNavButton { label: "Metadata"; icon_name: "metadata"; active: root.view == 5; clicked => { root.view = 5; root.metadata_criteria_changed(); } }
            TopNavButton { label: "Settings"; icon_name: "settings"; active: root.view == 6; clicked => { root.view = 6; root.settings_refresh(); if (root.settings_section == 1) { root.sync_refresh_profiles(); } } }
            Rectangle { width: 13px; Rectangle { x: 6px; y: (parent.height - self.height) / 2; width: 1px; height: 20px; background: Theme.border; } }
            ButtonChip { label: "Logout"; icon_name: "logout"; clicked => { root.logout(); } }
        }

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }
    }

    if (root.view == 0) : loading := LoadingPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        message: root.loading_message;
    }

    if (root.view == 1) : splash := SplashPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        sign_in => { root.sign_in(); }
    }

    if (root.view == 2) : code := CodePage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        code: root.device_code;
        expires: root.device_expires;
        back => { root.code_back(); }
        open_link => { root.code_open_link(); }
        copy_code => { root.code_copy(); }
        continue_to_files => { root.code_continue(); }
    }

    if (root.view == 3) : files := FilesPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        items: root.visible_items;
        path_segments: root.path_segments;
        has_parent: root.has_parent;
        folder_count: root.folder_count;
        file_count: root.file_count;
        total_label: root.total_label;
        detail_open: root.detail_open;
        detail_item: root.detail_item;
        query <=> root.files_query;
        mode <=> root.files_mode;
        sort_index <=> root.files_sort;
        sort_descending <=> root.files_sort_descending;
        open_item(id, item_type) => { root.files_open_item(id, item_type); }
        go_up => { root.files_go_up(); }
        go_root => { root.files_go_root(); }
        go_to_path(index) => { root.files_go_to_path(index); }
        set_sort(index) => { root.files_sort_changed(index); }
        set_mode(index) => { root.files_mode_changed(index); }
        toggle_sort_direction => { root.files_sort_direction_toggled(); }
        query_changed => { root.files_query_changed(); }
        close_detail => { root.files_close_detail(); }
        menu_action(action, id) => { root.files_menu_action(action, id); }
        play_item(id) => { root.files_menu_action("play", id); }
    }

    if (root.view == 4) : media := MediaPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
    }

    if (root.view == 7) : player := PlayerPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        texture <=> root.player_texture;
        title <=> root.player_title;
        close => { root.player_close(); }
    }

    if (root.view == 5) : metadata := MetadataPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        items: root.metadata_items;
        query <=> root.metadata_query;
        filter_index <=> root.metadata_filter;
        hide_matched <=> root.metadata_hide_matched;
        total_count: root.metadata_total_count;
        selected_count: root.metadata_selected_count;
        unmatched_count: root.metadata_unmatched_count;
        tv_count: root.metadata_tv_count;
        movie_count: root.metadata_movie_count;
        status: root.metadata_status;
        busy: root.metadata_busy;
        toggle_item(id) => { root.metadata_toggle_item(id); }
        toggle_expand(id) => { root.metadata_toggle_expand(id); }
        select_unmatched => { root.metadata_select_unmatched(); }
        clear_selection => { root.metadata_clear_selection(); }
        fetch_metadata => { root.metadata_fetch(); }
        criteria_changed => { root.metadata_criteria_changed(); }
    }

    if (root.view == 6) : settings := SettingsPage {
        x: 0px;
        y: Theme.title_bar_height;
        width: parent.width;
        height: parent.height - Theme.title_bar_height;
        section <=> root.settings_section;
        tmdb_local_key <=> root.tmdb_local_key;
        tmdb_putio_key <=> root.tmdb_putio_key;
        tmdb_source <=> root.tmdb_source;
        tmdb_status <=> root.tmdb_status;
        sync_profile_labels <=> root.sync_profile_labels;
        sync_existing_index <=> root.sync_existing_index;
        sync_new_name <=> root.sync_new_name;
        sync_status <=> root.sync_status;
        sync_played_count <=> root.sync_played_count;
        sync_known_count <=> root.sync_known_count;
        sync_active_profile <=> root.sync_active_profile;
        mpv_source <=> root.mpv_source;
        mpv_active_path <=> root.mpv_active_path;
        mpv_system_path <=> root.mpv_system_path;
        mpv_custom_path <=> root.mpv_custom_path;
        mpv_managed_path <=> root.mpv_managed_path;
        mpv_system_available <=> root.mpv_system_available;
        mpv_custom_available <=> root.mpv_custom_available;
        mpv_managed_available <=> root.mpv_managed_available;
        mpv_show_managed <=> root.mpv_show_managed;
        mpv_install_hint <=> root.mpv_install_hint;
        mpv_can_open_install_link <=> root.mpv_can_open_install_link;
        local_data_rows: root.local_data_rows;
        confirm_open <=> root.confirm_open;
        local_data_status <=> root.local_data_status;
        settings_refresh => { root.settings_refresh(); }
        tmdb_source_changed(source) => { root.tmdb_source_changed(source); }
        tmdb_save_local => { root.tmdb_save_local(); }
        tmdb_replace_putio => { root.tmdb_replace_putio(); }
        tmdb_delete_putio => { root.tmdb_delete_putio(); }
        sync_profile_selected(index) => { root.sync_profile_selected(index); }
        sync_refresh_profiles => { root.sync_refresh_profiles(); }
        sync_use_existing => { root.sync_use_existing(); }
        sync_use_new => { root.sync_use_new(); }
        sync_now => { root.sync_now(); }
        sync_disable => { root.sync_disable(); }
        mpv_source_changed(source) => { root.mpv_source_changed(source); }
        mpv_custom_path_edited => { root.mpv_custom_path_edited(); }
        mpv_browse_custom => { root.mpv_browse_custom(); }
        mpv_open_install_link => { root.mpv_open_install_link(); }
        local_data_clear(index) => { root.local_data_clear(index); }
        local_data_confirm_clear => { root.local_data_confirm_clear(); }
        local_data_cancel_clear => { root.local_data_cancel_clear(); }
    }
}
