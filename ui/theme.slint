export global Theme {
    in property <color> bg: #0a0a10;
    in property <color> surface: #14141c;
    in property <color> surface_hi: #1c1c26;
    in property <color> surface_higher: #22222d;
    in property <color> border: #ffffff10;
    in property <color> border_hi: #ffffff1a;
    in property <color> text: #f5f5f7;
    in property <color> text_dim: #8a8a99;
    in property <color> text_mute: #5a5a6a;
    in property <color> accent: #a78bfa;
    in property <color> accent_hi: #c4b5fd;
    in property <color> accent_soft: #a78bfa1a;
    in property <color> accent_border: #a78bfa4d;
    in property <color> success: #86efac;
    in property <color> warning: #fbbf24;
    in property <color> danger: #f87171;
    in property <string> ui_font: "Noto Sans";
    in property <string> mono_font: "JetBrainsMono Nerd Font";
    in property <length> radius_sm: 6px;
    in property <length> radius_md: 8px;
    in property <length> radius_lg: 10px;
    in property <length> title_bar_height: 52px;
}
