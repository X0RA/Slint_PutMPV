export struct FileItem {
    id: int,
    item_type: string,
    name: string,
    kind: string,
    grid_meta: string,
    list_kind: string,
    list_size: string,
    list_updated: string,
    detail_size: string,
    detail_kind: string,
    detail_extra_a_label: string,
    detail_extra_a_value: string,
    detail_extra_b_label: string,
    detail_extra_b_value: string,
    location: string,
    is_media: bool,
    is_watched: bool,
}

export struct PathSegment {
    id: int,
    name: string,
}

export struct MetadataItem {
    id: int,
    parent_id: int,
    media_type: string,
    title: string,
    subtitle: string,
    badge: string,
    filename: string,
    relative_path: string,
    season: int,
    episode: int,
    matched: bool,
    expanded: bool,
    selected: bool,
}

export struct SyncProfileItem {
    slug: string,
    name: string,
    file_id: int,
    label: string,
}

export struct LocalDataRow {
    name: string,
    desc: string,
    path: string,
    enabled: bool,
}

export struct PlayerTrack {
    id: string,
    name: string,
    detail: string,
}

export struct PlayerPlaylistItem {
    file_id: string,
    title: string,
    meta: string,
}

export struct TvSeasonTab {
    season_number: int,
    label: string,
}

export struct TvCreatorChip {
    name: string,
    initial: string,
    photo: image,
}

/// Hero genre/status badges: style 0 = status chip, 1 = in production, 2 = genre outline.
export struct TvHeroBadge {
    text: string,
    style: int,
}

export struct TvEpisodeCredit {
    name: string,
    role: string,
    photo: image,
}

export struct TvDetailItem {
    label: string,
    value: string,
}

export struct TvEpisodeRow {
    ep_num: int,
    title: string,
    air_date: string,
    duration_label: string,
    overview: string,
    rating_label: string,
    still: image,
    file_id: string,
    credits: [TvEpisodeCredit],
}
