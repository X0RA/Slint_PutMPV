import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonChip, IconButton, SearchField } from "../components/primitives.slint";
import { LoadingSpinner } from "../components/loading-spinner.slint";
import { Icon } from "../components/icons.slint";
import { RatingBadges } from "../components/rating-badges.slint";

export struct MediaItem {
    title: string,
    meta: string,
    rating: string,
    imdb_rating: string,
    poster: image,
    poster_loading: bool,
    backdrop: image,
    overview: string,
    year_label: string,
    stats_label: string,
    genre_line: string,
    resolution: string,
    progress: float,
    is_tv: bool,
    initials: string,
    file_id: string,
    added_at: string,
}

export struct MediaHeroItem {
    title: string,
    rating: string,
    imdb_rating: string,
    years: string,
    stats_line: string,
    overview: string,
    resume_label: string,
    poster: image,
    backdrop: image,
    progress: float,
    is_tv: bool,
    initials: string,
    file_id: string,
}

export struct MediaHeroBadge {
    text: string,
}

export struct MediaResumeItem {
    title: string,
    kind: string,
    detail: string,
    left_label: string,
    poster: image,
    poster_loading: bool,
    initials: string,
    progress: float,
    file_id: string,
}

export component PosterArt inherits Rectangle {
    in property <bool> loading: false;
    in property <string> initials;
    in property <image> art;
    in property <length> glyph-size: 72px;

    border-radius: 13px;
    clip: true;
    background: art.width > 0 ? #00000000 : @linear-gradient(165deg, Theme.surface_higher 0%, #0a0a12 100%);

    if art.width > 0 : Image {
        source: art;
        image-fit: cover;
        width: parent.width;
        height: parent.height;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(150deg, #ffffff12 0%, #00000000 38%, #00000080 100%);
    }

    if art.width == 0 && root.loading : LoadingSpinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    if art.width == 0 && !root.loading : VerticalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;

        Text {
            text: root.initials == "" ? "·" : root.initials;
            color: #ffffffeb;
            font-size: root.glyph-size;
            font-weight: 800;
            horizontal-alignment: center;
            font-family: Theme.ui_font;
        }
    }
}

component PosterCard inherits Rectangle {
    in property <MediaItem> data;
    in property <length> cell-width;

    width: cell-width;
    height: cell-width * 3 / 2 + 62px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;

    callback open();
    callback watch_toggle();
    callback play();

    poster := Rectangle {
        x: 0px;
        y: 0px;
        width: root.cell-width;
        height: root.cell-width * 3 / 2;
        border-radius: 13px;
        clip: true;
        border-width: 1px;
        border-color: #ffffff10;

        PosterArt {
            width: parent.width;
            height: parent.height;
            initials: root.data.initials;
            art: root.data.poster;
            loading: root.data.poster_loading;
        }

        if root.data.progress >= 0.9 : Rectangle {
            x: parent.width - 32px;
            y: 8px;
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: Theme.accent;

            Icon { x: 5px; y: 5px; name: "check"; icon_size: 14px; tint: Theme.text; }
            TouchArea { clicked => { if (!root.data.is_tv) { root.watch_toggle(); } } }
        }

        if root.data.progress > 0.0 && root.data.progress < 0.9 : Rectangle {
            x: 0px;
            y: parent.height - 4px;
            width: parent.width;
            height: 4px;
            background: #ffffff2c;

            Rectangle {
                x: 0px;
                width: parent.width * root.data.progress;
                height: parent.height;
                background: Theme.accent;
            }
        }

        poster-touch := TouchArea {
            accessible-role: button;
            accessible-label: "Details for " + root.data.title;
            accessible-action-default => { root.open(); }
            width: parent.width;
            height: parent.height;
            clicked => { root.open(); }
        }

        Rectangle {
            opacity: poster-touch.has-hover || play-touch.has-hover ? 1 : 0;
            width: parent.width;
            height: parent.height;
            background: #00000066;

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 54px;
                height: 54px;
                border-radius: 27px;
                background: Theme.accent;

                Icon { x: 18px; y: 17px; name: "play"; icon_size: 20px; tint: Theme.text; }
                play-touch := TouchArea {
                    accessible-role: button;
                    accessible-label: "Play " + root.data.title;
                    accessible-action-default => { root.play(); }
                    clicked => { root.play(); }
                }
            }
        }
    }

    Text {
        x: 2px;
        y: poster.y + poster.height + 18px;
        width: root.width - 4px;
        text: root.data.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
        font-family: Theme.ui_font;
    }

    Text {
        x: 2px;
        y: poster.y + poster.height + 39px;
        width: root.width - 4px;
        text: root.data.meta;
        color: Theme.text_dim;
        font-size: 12px;
        overflow: elide;
        font-family: Theme.ui_font;
    }
}

component HeroBadge inherits Rectangle {
    in property <string> label;

    height: 28px;
    width: label-t.preferred-width + 26px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #ffffff14;
    background: #ffffff08;

    label-t := Text {
        x: 13px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: Theme.text_dim;
        font-size: 12px;
        font-weight: 500;
        font-family: Theme.ui_font;
    }
}

component ToolbarChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;

    callback clicked();

    height: 36px;
    width: label-t.preferred-width + 30px;
    border-radius: 10px;
    border-width: 1px;
    border-color: active ? Theme.accent_border : Theme.border;
    background: active ? Theme.accent_soft : #ffffff05;

    states [
        hover when touch.has-hover : {
            background: active ? Theme.accent_soft : #ffffff09;
        }
    ]

    label-t := Text {
        x: 15px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: active ? Theme.accent_hi : Theme.text_dim;
        font-size: 13px;
        font-weight: 500;
        font-family: Theme.ui_font;
    }

    touch := TouchArea { clicked => { root.clicked(); } }
}

component MediaToolbar inherits Rectangle {
    in-out property <string> query;
    in-out property <int> filter_index;
    in-out property <int> sort_index;

    callback changed();
    callback sort_clicked();

    private property <bool> wrapped: root.width < 900px;

    height: wrapped ? 92px : 42px;
    clip: true;
    background: transparent;

    if !root.wrapped : HorizontalLayout {
        width: parent.width;
        height: 42px;
        spacing: 14px;

        SearchField {
            horizontal-stretch: 1;
            min-width: 280px;
            height: 42px;
            text <=> root.query;
            placeholder: "Search movies and shows...";
            edited => { root.changed(); }
            accepted => { root.changed(); }
        }

        HorizontalLayout {
            spacing: 14px;

            ToolbarChip { label: "All"; active: root.filter_index == 0; clicked => { root.filter_index = 0; root.changed(); } }
            ToolbarChip { label: "Movies"; active: root.filter_index == 1; clicked => { root.filter_index = 1; root.changed(); } }
            ToolbarChip { label: "TV Shows"; active: root.filter_index == 2; clicked => { root.filter_index = 2; root.changed(); } }
            ToolbarChip { label: "Unwatched"; active: root.filter_index == 3; clicked => { root.filter_index = 3; root.changed(); } }

            Rectangle {
                height: 36px;
                width: 154px;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.sort_index == 1 ? Theme.accent_border : Theme.border;
                background: root.sort_index == 1 ? Theme.accent_soft : #ffffff04;

                Icon { x: 16px; y: 10px; name: "sort"; icon_size: 15px; tint: root.sort_index == 1 ? Theme.accent_hi : Theme.text_dim; }
                Text {
                    x: 40px;
                    y: (parent.height - self.height) / 2;
                    text: "Recently added";
                    color: root.sort_index == 1 ? Theme.accent_hi : Theme.text_dim;
                    font-size: 12.5px;
                    font-weight: 500;
                    font-family: Theme.ui_font;
                }

                TouchArea {
                    clicked => {
                        root.sort_index = 1;
                        root.sort_clicked();
                    }
                }
            }
        }
    }

    if root.wrapped : VerticalLayout {
        width: parent.width;
        spacing: 8px;
        alignment: start;

        SearchField {
            width: parent.width;
            height: 42px;
            text <=> root.query;
            placeholder: "Search movies and shows...";
            edited => { root.changed(); }
            accepted => { root.changed(); }
        }

        HorizontalLayout {
            spacing: 14px;

            ToolbarChip { label: "All"; active: root.filter_index == 0; clicked => { root.filter_index = 0; root.changed(); } }
            ToolbarChip { label: "Movies"; active: root.filter_index == 1; clicked => { root.filter_index = 1; root.changed(); } }
            ToolbarChip { label: "TV Shows"; active: root.filter_index == 2; clicked => { root.filter_index = 2; root.changed(); } }
            ToolbarChip { label: "Unwatched"; active: root.filter_index == 3; clicked => { root.filter_index = 3; root.changed(); } }

            Rectangle {
                height: 36px;
                width: 154px;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.sort_index == 1 ? Theme.accent_border : Theme.border;
                background: root.sort_index == 1 ? Theme.accent_soft : #ffffff04;

                Icon { x: 16px; y: 10px; name: "sort"; icon_size: 15px; tint: root.sort_index == 1 ? Theme.accent_hi : Theme.text_dim; }
                Text {
                    x: 40px;
                    y: (parent.height - self.height) / 2;
                    text: "Recently added";
                    color: root.sort_index == 1 ? Theme.accent_hi : Theme.text_dim;
                    font-size: 12.5px;
                    font-weight: 500;
                    font-family: Theme.ui_font;
                }

                TouchArea {
                    clicked => {
                        root.sort_index = 1;
                        root.sort_clicked();
                    }
                }
            }
        }
    }
}

component MetadataReminder inherits Rectangle {
    in property <bool> busy;
    in property <bool> has_unmatched;
    in property <string> unmatched_title;
    in property <string> unmatched_detail;
    in property <bool> show_error_flash;
    in property <string> error_flash_text;
    in property <bool> show_success_flash;
    in property <string> success_flash_text;

    callback scrape_unmatched();
    callback dismiss_error();
    callback dismiss_success();

    height: (busy || has_unmatched || show_error_flash || show_success_flash) ? 58px : 0px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.accent_border;
    background: Theme.accent_soft;

    if root.has_unmatched || root.busy : Rectangle {
        x: 16px;
        y: 14px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: #a78bfa22;

        if !root.busy : Icon { x: 8px; y: 8px; name: "refresh"; icon_size: 14px; tint: Theme.accent_hi; }
        if root.busy : LoadingSpinner { label: "Scraping metadata"; width: 18px; height: 18px; x: 6px; y: 6px; }
    }

    if root.has_unmatched || root.busy : Text {
        x: 59px;
        y: 0px;
        width: max(0px, parent.width - 252px);
        height: parent.height;
        text: root.busy ? "Scraping metadata… This can take a little while." : root.unmatched_title + (root.unmatched_detail == "" ? "" : " · " + root.unmatched_detail);
        color: Theme.text_dim;
        font-size: 13px;
        font-weight: 500;
        overflow: elide;
        vertical-alignment: center;
        font-family: Theme.ui_font;
    }

    if root.has_unmatched || root.busy : ButtonChip {
        x: parent.width - self.width - 58px;
        y: 13px;
        active: true;
        label: root.busy ? "Scraping…" : "Run scraper";
        enabled: !root.busy;
        icon_name: "refresh";
        clicked => { root.scrape_unmatched(); }
    }

    if root.has_unmatched || root.busy : IconButton {
        x: parent.width - self.width - 16px;
        y: 17px;
        icon_name: "close";
        clicked => { root.dismiss_success(); root.dismiss_error(); }
    }

    if !root.busy && !root.has_unmatched && root.show_error_flash : Icon {
        x: 18px;
        y: 21px;
        name: "metadata";
        icon_size: 16px;
        tint: Theme.danger;
    }

    if !root.busy && !root.has_unmatched && root.show_error_flash : Text {
        x: 46px;
        y: 0px;
        width: max(0px, parent.width - 190px);
        height: parent.height;
        text: root.error_flash_text;
        color: Theme.text_dim;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
        font-family: Theme.ui_font;
    }

    if !root.busy && !root.has_unmatched && root.show_error_flash : ButtonChip {
        x: parent.width - self.width - 58px;
        y: 13px;
        label: "Try Again";
        clicked => { root.scrape_unmatched(); }
    }

    if !root.busy && !root.has_unmatched && root.show_error_flash : IconButton {
        x: parent.width - self.width - 16px;
        y: 17px;
        icon_name: "close";
        clicked => { root.dismiss_error(); }
    }

    if !root.busy && !root.has_unmatched && !root.show_error_flash && root.show_success_flash : Icon {
        x: 18px;
        y: 21px;
        name: "check";
        icon_size: 16px;
        tint: Theme.success;
    }

    if !root.busy && !root.has_unmatched && !root.show_error_flash && root.show_success_flash : Text {
        x: 46px;
        y: 0px;
        width: max(0px, parent.width - 150px);
        height: parent.height;
        text: root.success_flash_text == "" ? "Matches saved." : root.success_flash_text;
        color: Theme.text_dim;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
        font-family: Theme.ui_font;
    }

    if !root.busy && !root.has_unmatched && !root.show_error_flash && root.show_success_flash : ButtonChip {
        x: parent.width - self.width - 16px;
        y: 13px;
        label: "Dismiss";
        clicked => { root.dismiss_success(); }
    }
}

component HeroSpotlight inherits Rectangle {
    callback play();
    in property <MediaHeroItem> item;
    in property <[MediaHeroBadge]> badges;
    in property <bool> compact: false;

    callback open();

    height: compact ? 430px : 520px;
    clip: true;
    background: Theme.bg;

    if item.backdrop.width > 0 : Image {
        width: parent.width;
        height: parent.height;
        source: root.item.backdrop;
        image-fit: cover;
        opacity: 0.42;
    }

    if item.backdrop.width == 0 && item.poster.width > 0 : Image {
        x: parent.width * 0.56;
        width: parent.width * 0.44;
        height: parent.height;
        source: root.item.poster;
        image-fit: cover;
        opacity: 0.28;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(circle, #8b1f1f92 0%, #0b0b1073 50%, Theme.bg 82%);
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(90deg, #0b0b10fa 0%, #0b0b10d4 35%, #0b0b1048 72%, #0b0b1088 100%);
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @linear-gradient(180deg, #00000000 0%, #00000000 64%, Theme.bg 100%);
    }

    Text {
        x: parent.width - self.width - 64px;
        y: (parent.height - self.height) / 2 - 12px;
        text: root.item.initials == "" ? "M" : root.item.initials;
        color: #ffffff12;
        font-size: compact ? 180px : 250px;
        font-weight: 800;
        font-family: Theme.ui_font;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: compact ? 28px : 48px;
        padding-right: compact ? 28px : 48px;
        alignment: center;

        VerticalLayout {
            width: compact ? parent.width - 56px : min(620px, parent.width - 96px);
            spacing: compact ? 10px : 13px;
            alignment: start;

        HorizontalLayout {
            height: 18px;
            spacing: 8px;
            Icon { name: "star"; icon_size: 14px; tint: Theme.accent_hi; y: 2px; }
            Text {
                text: "FEATURED";
                color: Theme.accent_hi;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 2px;
                font-family: Theme.ui_font;
            }
        }

        Text {
            text: root.item.title == "" ? "Media Library" : root.item.title;
            color: Theme.text;
            font-size: compact ? 32px : 50px;
            font-weight: 800;
            wrap: word-wrap;
            font-family: Theme.ui_font;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            if root.item.rating != "" || root.item.imdb_rating != "" : hero-ratings := RatingBadges {
                tmdb: root.item.rating;
                imdb: root.item.imdb_rating;
                font_size: 14px;
                value_weight: 700;
            }

            if root.item.years != "" : Text { text: root.item.years; color: Theme.text_dim; font-size: 14px; font-family: Theme.ui_font; }
            if root.item.stats_line != "" : Text { text: "·  " + root.item.stats_line; color: Theme.text_dim; font-size: 14px; font-family: Theme.ui_font; }
        }

        if root.item.overview != "" : Text {
            width: min(620px, parent.width);
            text: root.item.overview;
            color: #d6d4e0;
            font-size: compact ? 13px : 15px;
            wrap: word-wrap;
            font-family: Theme.ui_font;
        }

        if root.badges.length > 0 : HorizontalLayout {
            spacing: 8px;
            width: parent.width;
            for badge in root.badges: HeroBadge { label: badge.text; }
        }

        HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: play-t.preferred-width + 56px;
                height: 46px;
                border-radius: 12px;
                background: Theme.accent;

                Icon { x: 18px; y: 14px; name: "play"; icon_size: 17px; tint: Theme.text; }
                play-t := Text {
                    x: 44px;
                    y: (parent.height - self.height) / 2;
                    text: root.item.resume_label == "" ? "Play" : root.item.resume_label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    font-family: Theme.ui_font;
                }
                TouchArea { clicked => { root.play(); } }
            }

            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.border_hi;
                background: #ffffff12;
                Text {
                    text: "i";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-family: Theme.ui_font;
                }
                TouchArea { clicked => { root.open(); } }
            }
        }
        }
    }
}

component ResumeCard inherits Rectangle {
    in property <MediaResumeItem> data;

    callback open();

    width: 332px;
    height: 116px;
    border-radius: 15px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    PosterArt {
        x: 11px;
        y: 11px;
        width: 64px;
        height: 92px;
        initials: root.data.initials;
        art: root.data.poster;
            loading: root.data.poster_loading;
        glyph-size: 28px;
    }

    HorizontalLayout {
        x: 88px;
        y: 12px;
        width: parent.width - 100px;
        height: 16px;
        spacing: 7px;
        alignment: start;

        Text { text: root.data.kind; color: Theme.accent_hi; font-size: 10.5px; font-weight: 700; letter-spacing: 1px; font-family: Theme.ui_font; }
        Text { text: root.data.left_label; color: Theme.text_dim; font-size: 11.5px; overflow: elide; font-family: Theme.ui_font; }
    }

    Text {
        x: 88px;
        y: 32px;
        width: parent.width - 100px;
        text: root.data.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 700;
        overflow: elide;
        font-family: Theme.ui_font;
    }

    Text {
        x: 88px;
        y: 52px;
        width: parent.width - 100px;
        text: root.data.detail;
        color: Theme.text_dim;
        font-size: 12px;
        overflow: elide;
        font-family: Theme.ui_font;
    }

    Rectangle {
        x: 88px;
        y: parent.height - 16px;
        width: parent.width - 100px;
        height: 4px;
        border-radius: 2px;
        background: #ffffff1e;
        clip: true;

        Rectangle {
            x: 0px;
            width: parent.width * root.data.progress;
            height: parent.height;
            background: Theme.accent;
        }
    }

    touch := TouchArea { clicked => { root.open(); } }
}

component SectionTitle inherits Rectangle {
    callback see_all();
    in property <string> title;
    in property <int> count;
    in property <string> noun;

    height: 28px;
    background: transparent;

    Text {
        x: 0px;
        y: (parent.height - self.height) / 2;
        text: root.title;
        color: Theme.text;
        font-size: 21px;
        font-weight: 700;
        font-family: Theme.ui_font;
    }

    Text {
        x: title-t.preferred-width + 12px;
        y: (parent.height - self.height) / 2 + 2px;
        text: root.count + " " + root.noun;
        color: Theme.text_dim;
        font-size: 13px;
        font-family: Theme.ui_font;
    }

    title-t := Text { text: root.title; opacity: 0; font-size: 21px; font-weight: 700; font-family: Theme.ui_font; }

    HorizontalLayout {
        x: parent.width - self.width;
        width: see.preferred-width + 18px;
        height: parent.height;
        spacing: 5px;
        see := Text { text: "See all"; color: Theme.text_dim; font-size: 13px; vertical-alignment: center; font-family: Theme.ui_font; }
        Icon { name: "chevron-right"; icon_size: 13px; tint: Theme.text_dim; y: 8px; }
    }
    see-all-touch := TouchArea {
        x: parent.width - self.width;
        width: 80px;
        height: parent.height;
        accessible-role: button;
        accessible-label: "See all " + root.title;
        accessible-action-default => { root.see_all(); }
        clicked => { root.see_all(); }
    }
}

export component MediaCollectionPage inherits Rectangle {
    in property <string> title;
    in property <[MediaItem]> items;
    in-out property <string> query;
    in-out property <int> sort_index;
    callback back();
    callback changed();
    callback sort_changed();
    callback open(string);
    callback play(string);
    callback watch_toggle(string);
    background: Theme.bg;
    // Leave room for the vertical scrollbar as well as the page gutters.
    private property <length> grid-width: max(1px, root.width - 64px);
    private property <int> columns: max(1, floor(root.grid-width / 190px));
    private property <length> card-width: (root.grid-width - (columns - 1) * 20px) / columns;
    private property <length> row-height: card-width * 1.5 + 82px;

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        HorizontalLayout {
            alignment: start;
            spacing: 20px;
            ButtonChip { label: "Back to Media"; icon_name: "arrow-left"; clicked => { root.back(); } }
            Text { text: root.title; color: Theme.text; font-size: 26px; font-weight: 700; }
            Text { text: root.items.length + (root.items.length == 1 ? " title" : " titles"); color: Theme.text_dim; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 16px;
            SearchField {
                horizontal-stretch: 1;
                text <=> root.query;
                placeholder: "Search " + root.title.to-lowercase() + "…";
                edited => { root.changed(); }
                accepted => { root.changed(); }
            }
            ButtonChip {
                label: root.sort_index == 0 ? "Sort A–Z" : "Recently added";
                icon_name: "sort";
                clicked => { root.sort_index = root.sort_index == 0 ? 1 : 0; root.sort_changed(); }
            }
        }
        if root.items.length == 0 : Text {
            text: root.query == "" ? "No titles in this collection yet." : "No titles match your search.";
            color: Theme.text_dim;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if root.items.length > 0 : ScrollView {
            viewport-width: self.visible-width;
            viewport-height: ceil(root.items.length / root.columns) * root.row-height;
            for item[index] in root.items : PosterCard {
                x: mod(index, root.columns) * (root.card-width + 20px);
                y: floor(index / root.columns) * root.row-height;
                cell-width: root.card-width;
                data: item;
                open => { root.open(item.file_id); }
                play => { root.play(item.file_id); }
                watch_toggle => { root.watch_toggle(item.file_id); }
            }
        }
    }
}

export component MediaPage inherits Rectangle {
    in property <bool> busy;
    in-out property <int> collection_kind: 0;
    callback media_play(string);
    callback see_all(int);
    callback collection_back();
    background: Theme.bg;

    private property <bool> compact: root.width < 900px;
    private property <length> gutter: compact ? 20px : 32px;
    private property <length> content-w: root.width - root.gutter * 2;
    private property <length> shelf-card-w: compact ? 154px : 194px;
    private property <bool> has-banner-content: root.busy || root.has_unmatched || root.show_error_flash || root.show_success_flash;
    private property <bool> show-movies-section: (root.filter_index == 0 || root.filter_index == 1 || root.filter_index == 3) && root.movies.length > 0;
    private property <bool> show-tv-section: (root.filter_index == 0 || root.filter_index == 2 || root.filter_index == 3) && root.shows.length > 0;

    in property <bool> has_unmatched;
    in property <string> unmatched_title;
    in property <string> unmatched_detail;
    in property <bool> show_error_flash;
    in property <string> error_flash_text;
    in property <bool> show_success_flash;
    in property <string> success_flash_text;

    in property <[MediaItem]> movies;
    in property <[MediaItem]> shows;
    in property <MediaHeroItem> hero;
    in property <[MediaHeroBadge]> hero_badges;
    in property <[MediaResumeItem]> resume_items;
    in-out property <string> query;
    in-out property <int> filter_index: 0;
    in-out property <int> sort_index: 0;

    callback scrape_unmatched();
    callback dismiss_error();
    callback dismiss_success();
    callback media_item_clicked(string);
    callback media_watch_toggle(string);
    callback media_filter_changed();
    callback media_sort_changed();

    if root.collection_kind == 0 : scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, stack.preferred-height);

        stack := VerticalLayout {
            width: root.width;
            spacing: 0px;
            alignment: start;

            HeroSpotlight {
                width: root.width;
                item: root.hero;
                badges: root.hero_badges;
                compact: root.compact;
                open => { root.media_item_clicked(root.hero.file_id); }
                play => { root.media_play(root.hero.file_id); }
            }

            VerticalLayout {
                width: parent.width;
                padding-left: root.gutter;
                padding-right: root.gutter;
                padding-top: 26px;
                padding-bottom: 52px;
                spacing: 20px;

                MediaToolbar {
                    width: root.content-w;
                    query <=> root.query;
                    filter_index <=> root.filter_index;
                    sort_index <=> root.sort_index;
                    changed => { root.media_filter_changed(); }
                    sort_clicked => { root.media_sort_changed(); }
                }

                if root.has-banner-content : MetadataReminder {
                    width: root.content-w;
                    busy: root.busy;
                    has_unmatched: root.has_unmatched;
                    unmatched_title: root.unmatched_title;
                    unmatched_detail: root.unmatched_detail;
                    show_error_flash: root.show_error_flash;
                    error_flash_text: root.error_flash_text;
                    show_success_flash: root.show_success_flash;
                    success_flash_text: root.success_flash_text;
                    scrape_unmatched => { root.scrape_unmatched(); }
                    dismiss_error => { root.dismiss_error(); }
                    dismiss_success => { root.dismiss_success(); }
                }

                if root.resume_items.length > 0 : VerticalLayout {
                    width: root.content-w;
                    spacing: 16px;

                    HorizontalLayout {
                        height: 24px;
                        spacing: 9px;
                        Icon { name: "clock"; icon_size: 18px; tint: Theme.accent_hi; y: 2px; }
                        Text { text: "Continue Watching"; color: Theme.text; font-size: 20px; font-weight: 700; font-family: Theme.ui_font; }
                    }

                    Rectangle {
                        width: root.content-w;
                        height: 116px;
                        clip: true;

                        HorizontalLayout {
                            width: root.content-w;
                            height: parent.height;
                            spacing: 18px;

                            for item in root.resume_items: ResumeCard {
                                data: item;
                                open => { root.media_play(item.file_id); }
                            }
                        }
                    }
                }

                if root.show-movies-section : VerticalLayout {
                    width: root.content-w;
                    spacing: 16px;
                    padding-top: 12px;

                    SectionTitle { width: root.content-w; title: "Movies"; count: root.movies.length; noun: "titles"; see_all => { root.see_all(1); } }

                    Rectangle {
                        width: root.content-w;
                        height: root.shelf-card-w * 3 / 2 + 62px;
                        clip: true;

                        HorizontalLayout {
                            width: root.content-w;
                            height: parent.height;
                            spacing: 18px;

                            for item in root.movies: PosterCard {
                                cell-width: root.shelf-card-w;
                                data: item;
                                open => { root.media_item_clicked(item.file_id); }
                                play => { root.media_play(item.file_id); }
                                watch_toggle => { root.media_watch_toggle(item.file_id); }
                            }
                        }
                    }
                }

                if root.show-tv-section : VerticalLayout {
                    width: root.content-w;
                    spacing: 16px;
                    padding-top: 14px;

                    SectionTitle { width: root.content-w; title: "TV Shows"; count: root.shows.length; noun: "series"; see_all => { root.see_all(2); } }

                    Rectangle {
                        width: root.content-w;
                        height: root.shelf-card-w * 3 / 2 + 62px;
                        clip: true;

                        HorizontalLayout {
                            width: root.content-w;
                            height: parent.height;
                            spacing: 18px;

                            for item in root.shows: PosterCard {
                                cell-width: root.shelf-card-w;
                                data: item;
                                open => { root.media_item_clicked(item.file_id); }
                                play => { root.media_play(item.file_id); }
                                watch_toggle => { root.media_watch_toggle(item.file_id); }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.collection_kind > 0 : MediaCollectionPage {
        width: parent.width;
        height: parent.height;
        title: root.collection_kind == 1 ? "Movies" : "TV Shows";
        items: root.collection_kind == 1 ? root.movies : root.shows;
        query <=> root.query;
        sort_index <=> root.sort_index;
        back => { root.collection_back(); }
        changed => { root.media_filter_changed(); }
        sort_changed => { root.media_sort_changed(); }
        open(id) => { root.media_item_clicked(id); }
        play(id) => { root.media_play(id); }
        watch_toggle(id) => { root.media_watch_toggle(id); }
    }

}
