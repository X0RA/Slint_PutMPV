import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonChip, IconButton } from "../components/primitives.slint";
import { Icon } from "../components/icons.slint";

export struct MediaItem {
    title: string,
    meta: string,
    rating: string,
    poster: image,
    resolution: string,
    progress: float,
    is_tv: bool,
    initials: string,
    file_id: string,
}

component HubPoster inherits Rectangle {
    in property <string> title;
    in property <string> initials;
    in property <length> poster-height;
    in property <image> art;
    /// When false, omit the bottom-centered title strip (e.g. hub cards show title below the poster).
    in property <bool> show-embedded-title: true;
    /// Fill cell with no frame—outer container handles clipping and corners.
    in property <bool> flat: false;

    width: self.height * 2 / 3;
    height: poster-height;
    border-radius: flat ? 0px : 8px;
    clip: true;
    background: art.width > 0 ? #00000000 : @linear-gradient(165deg, Theme.surface_higher 0%, #0a0a12 100%);
    border-width: flat ? 0px : 1px;
    border-color: #ffffff12;

    if art.width > 0 : Image {
        source: art;
        image-fit: cover;
        width: parent.width;
        height: parent.height;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: @radial-gradient(circle, #ffffff28 0%, #00000000 65%);
    }

    if art.width == 0 : VerticalLayout {
        width: parent.width;
        height: parent.height;
        alignment: center;
        padding-top: poster-height * 0.12;
        padding-bottom: poster-height * 0.12;
        padding-left: poster-height * 0.08;
        padding-right: poster-height * 0.08;

        Text {
            text: initials == "" ? "·" : initials;
            color: #ffffffeb;
            font-size: poster-height * 0.14;
            font-weight: 800;
            letter-spacing: -1px;
            horizontal-alignment: center;
            font-family: Theme.ui_font;
        }
    }

    if show-embedded-title : Text {
        y: parent.height - self.height - 8px;
        x: 8px;
        width: parent.width - 16px;
        text: title;
        color: #ffffffd9;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.2px;
        horizontal-alignment: center;
        wrap: no-wrap;
        overflow: elide;
        font-family: Theme.ui_font;
    }
}

component HubMediaCard inherits TouchArea {
    in property <MediaItem> data;
    in property <length> cell-width;

    width: cell-width;
    horizontal-stretch: 0;

    callback open();

    clicked => {
        root.open();
    }

    VerticalLayout {
        spacing: 0px;
        width: root.width;

        Rectangle {
            width: parent.width;
            background: Theme.surface;
            border-radius: Theme.radius_lg;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                width: parent.width;

                Rectangle {
                    width: parent.width;
                    height: root.cell-width * 3 / 2;
                    clip: true;

                    HubPoster {
                        flat: true;
                        show-embedded-title: false;
                        width: parent.width;
                        height: parent.height;
                        title: root.data.title;
                        initials: root.data.initials;
                        poster-height: parent.height;
                        art: root.data.poster;
                    }

                    Rectangle {
                        y: parent.height - 72px;
                        width: parent.width;
                        height: 72px;
                        background: @linear-gradient(180deg, #00000000 0%, Theme.surface 100%);
                    }

                    if root.data.rating != "" : Rectangle {
                        x: parent.width - self.width - 10px;
                        y: parent.height - self.height - 10px;
                        height: 24px;
                        width: rate-t.preferred-width + 34px;
                        border-radius: 8px;
                        background: #000000cc;
                        border-width: 1px;
                        border-color: #ffffff18;

                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 4px;
                            alignment: center;

                            Icon {
                                name: "star";
                                icon_size: 11px;
                                tint: Theme.accent;
                                y: (parent.height - self.height) / 2;
                            }

                            rate-t := Text {
                                height: parent.height;
                                text: root.data.rating;
                                color: #ffffff;
                                font-size: 10.5px;
                                font-weight: 700;
                                vertical-alignment: center;
                                font-family: Theme.mono_font;
                            }
                        }
                    }

                    if root.has-hover : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: #00000059;

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 48px;
                            height: 48px;
                            border-radius: 24px;
                            background: Theme.accent;

                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                name: "play";
                                icon_size: 18px;
                                tint: Theme.bg;
                            }
                        }
                    }
                }

                VerticalLayout {
                    width: parent.width;
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 12px;
                    padding-bottom: 14px;
                    spacing: 5px;
                    alignment: start;

                    Text {
                        text: root.data.title;
                        color: Theme.text;
                        font-size: 13.5px;
                        font-weight: 700;
                        wrap: no-wrap;
                        overflow: elide;
                        font-family: Theme.ui_font;
                    }

                    Text {
                        text: root.data.meta;
                        color: Theme.text_dim;
                        font-size: 11px;
                        font-family: Theme.ui_font;
                    }
                }
            }
        }
    }

}

component MetadataStrip inherits VerticalLayout {
    in property <length> gutter;
    in property <length> content-w;
    in property <bool> has_unmatched;
    in property <string> unmatched_title;
    in property <string> unmatched_detail;
    in property <bool> show_error_flash;
    in property <string> error_flash_text;
    in property <bool> show_success_flash;
    in property <string> success_flash_text;

    callback scrape_unmatched();
    callback dismiss_error();
    callback dismiss_success();

    width: 100%;
    spacing: 0px;

    Rectangle {
        width: parent.width;
        background: #14141ccc;

        HorizontalLayout {
            width: parent.width;
            alignment: center;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
            }

            VerticalLayout {
                padding-left: root.gutter;
                padding-right: root.gutter;
                padding-top: 10px;
                padding-bottom: 11px;
                width: root.content-w;
                spacing: 8px;

                if root.has_unmatched : HorizontalLayout {
                    spacing: 14px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.unmatched_title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: -0.2px;
                            font-family: Theme.ui_font;
                        }

                        Text {
                            text: root.unmatched_detail;
                            color: Theme.text_mute;
                            font-size: 11.5px;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }
                    }

                    ButtonChip {
                        primary: true;
                        label: "Scrape Unmatched Media";
                        icon_name: "refresh";
                        clicked => { root.scrape_unmatched(); }
                    }
                }

                if root.has_unmatched && (root.show_error_flash || root.show_success_flash) : Rectangle {
                    height: 1px;
                    background: Theme.border_hi;
                }

                if root.show_error_flash : HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        width: 16px;
                        height: 16px;

                        Icon {
                            x: 0px;
                            y: 1px;
                            name: "metadata";
                            icon_size: 15px;
                            tint: Theme.danger;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Couldn't scrape unmatched media.";
                            color: Theme.text;
                            font-size: 11.5px;
                            font-weight: 700;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }

                        Text {
                            text: root.error_flash_text;
                            color: Theme.text_mute;
                            font-size: 11px;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }
                    }

                    ButtonChip {
                        label: "Try Again";
                        clicked => { root.scrape_unmatched(); }
                    }

                    IconButton {
                        icon_name: "close";
                        clicked => { root.dismiss_error(); }
                    }
                }

                if root.show_success_flash : HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        width: 16px;
                        height: 16px;

                        Icon {
                            name: "check";
                            icon_size: 15px;
                            tint: Theme.success;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Matches saved.";
                            color: Theme.text;
                            font-size: 11.5px;
                            font-weight: 700;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }

                        Text {
                            text: root.success_flash_text;
                            color: Theme.text_mute;
                            font-size: 11px;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }
                    }

                    ButtonChip {
                        label: "Dismiss";
                        clicked => { root.dismiss_success(); }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: 1px;
        background: Theme.border_hi;
    }
}

export component MediaPage inherits Rectangle {
    background: Theme.bg;

    private property <bool> compact: root.width < 760px;
    private property <length> gutter: compact ? 20px : 36px;
    private property <length> inner-max: root.width - gutter * 2;
    private property <length> content-w: inner-max;
    private property <int> hub-cols: root.width < 560px ? 3 : root.width < 820px ? 4 : root.width < 1100px ? 5 : 6;
    private property <length> hub-gap: 18px;
    private property <length> hub-cell-w: (content-w - hub-gap * (hub-cols - 1)) / hub-cols;

    in property <bool> has_unmatched;
    in property <string> unmatched_title;
    in property <string> unmatched_detail;
    in property <bool> show_error_flash;
    in property <string> error_flash_text;
    in property <bool> show_success_flash;
    in property <string> success_flash_text;


    in property <[MediaItem]> movies;
    in property <[MediaItem]> shows;

    callback scrape_unmatched();
    callback dismiss_error();
    callback dismiss_success();
    callback media_item_clicked(string);

    private property <bool> has-banner-content: root.has_unmatched || root.show_error_flash || root.show_success_flash;

    scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, stack.preferred-height + 48px);

        stack := VerticalLayout {
            width: root.width;
            spacing: 0px;
            alignment: start;

            if root.has-banner-content : MetadataStrip {
                gutter: root.gutter;
                content-w: root.content-w;
                has_unmatched: root.has_unmatched;
                unmatched_title: root.unmatched_title;
                unmatched_detail: root.unmatched_detail;
                show_error_flash: root.show_error_flash;
                error_flash_text: root.error_flash_text;
                show_success_flash: root.show_success_flash;
                success_flash_text: root.success_flash_text;
                scrape_unmatched => { root.scrape_unmatched(); }
                dismiss_error => { root.dismiss_error(); }
                dismiss_success => { root.dismiss_success(); }
            }

            HorizontalLayout {
                width: parent.width;
                alignment: center;

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                }

                VerticalLayout {
                    width: content-w;
                    spacing: 0px;

                    VerticalLayout {
                        padding-top: 28px;
                        padding-bottom: 8px;
                        spacing: 16px;
                        width: parent.width;

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 20px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                                Text {
                                    text: "Movies";
                                    color: Theme.text;
                                    font-size: 20px;
                                    font-weight: 600;
                                    letter-spacing: -0.4px;
                                    font-family: Theme.ui_font;
                                }
                            }
                        }

                        GridLayout {
                            spacing: hub-gap;
                            width: parent.width;

                            for item[idx] in root.movies: HubMediaCard {
                                row: idx / root.hub-cols;
                                col: Math.mod(idx, root.hub-cols);
                                cell-width: root.hub-cell-w;
                                data: item;
                                open => {
                                    root.media_item_clicked(item.file_id);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        padding-top: 28px;
                        padding-bottom: 40px;
                        spacing: 16px;
                        width: parent.width;

                        HorizontalLayout {
                            alignment: space-between;
                            spacing: 20px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                                Text {
                                    text: "TV Shows";
                                    color: Theme.text;
                                    font-size: 20px;
                                    font-weight: 600;
                                    letter-spacing: -0.4px;
                                    font-family: Theme.ui_font;
                                }
                            }
                        }

                        GridLayout {
                            spacing: hub-gap;
                            width: parent.width;

                            for item[idx] in root.shows: HubMediaCard {
                                row: idx / root.hub-cols;
                                col: Math.mod(idx, root.hub-cols);
                                cell-width: root.hub-cell-w;
                                data: item;
                                open => {
                                    root.media_item_clicked(item.file_id);
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
            }
        }
    }
}
