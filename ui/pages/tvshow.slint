import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { ButtonChip } from "../components/primitives.slint";
import { Icon } from "../components/icons.slint";
import { TvSeasonTab, TvEpisodeRow, TvCreatorChip, TvHeroBadge, TvEpisodeCredit, TvDetailItem } from "../types.slint";

/// Genre/status pill in the hero — thin outline style.
component HeroPill inherits Rectangle {
    in property <TvHeroBadge> badge;
    border-radius: 12px;
    border-width: 1px;
    border-color: badge.style == 1 ? Theme.accent : Theme.border;
    background: badge.style == 1 ? Theme.accent_soft : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 6px;
        padding-bottom: 6px;

        Text {
            text: root.badge.text;
            color: badge.style == 1 ? Theme.accent_hi : Theme.text_dim;
            font-size: 12px;
            font-weight: 500;
            font-family: Theme.ui_font;
        }
    }
}

/// Paired column: two stacked label/value items share one equal-width column slot.
component DetailColumn inherits Rectangle {
    in property <string> label1;
    in property <string> value1;
    in property <string> label2;
    in property <string> value2;
    horizontal-stretch: 1;
    min-width: 0;
    background: transparent;

    VerticalLayout {
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            spacing: 3px;
            Text { text: root.label1; color: Theme.text_mute; font-size: 11px; font-weight: 500; overflow: elide; horizontal-alignment: center; font-family: Theme.ui_font; }
            Text { text: root.value1; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; horizontal-alignment: center; font-family: Theme.ui_font; }
        }

        if root.label2 != "" : VerticalLayout {
            spacing: 3px;
            Text { text: root.label2; color: Theme.text_mute; font-size: 11px; font-weight: 500; overflow: elide; horizontal-alignment: center; font-family: Theme.ui_font; }
            Text { text: root.value2; color: Theme.text; font-size: 13px; font-weight: 600; overflow: elide; horizontal-alignment: center; font-family: Theme.ui_font; }
        }
    }
}

/// Guest / crew portrait chip on an episode card.
component EpisodeCreditCard inherits Rectangle {
    in property <TvEpisodeCredit> credit;
    width: 64px;
    height: 116px;
    background: transparent;
    clip: true;

    VerticalLayout {
        spacing: 4px;
        alignment: center;
        width: parent.width;
        height: parent.height;

        Rectangle {
            width: 56px;
            height: 72px;
            border-radius: 7px;
            clip: true;
            background: Theme.surface_higher;
            border-width: 1px;
            border-color: Theme.border;

            if credit.photo.width > 0 : Image {
                width: parent.width;
                height: parent.height;
                source: credit.photo;
                image-fit: cover;
            }

            if credit.photo.width == 0 : Text {
                width: parent.width;
                height: parent.height;
                text: "?";
                color: Theme.text_mute;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-family: Theme.ui_font;
            }
        }

        Text {
            text: credit.name;
            color: Theme.text;
            font-size: 10px;
            font-weight: 600;
            width: parent.width;
            overflow: elide;
            horizontal-alignment: center;
            font-family: Theme.ui_font;
        }

        Text {
            text: credit.role;
            color: Theme.text_mute;
            font-size: 9px;
            width: parent.width;
            overflow: elide;
            horizontal-alignment: center;
            font-family: Theme.ui_font;
        }
    }
}

export component TvShowPage inherits Rectangle {
    background: Theme.bg;

    in property <string> title;
    in property <string> tagline;
    in property <string> rating_label;
    in property <string> years_label;
    in property <string> overview;
    in property <string> stats_line;
    in property <[TvHeroBadge]> hero_badges;
    in property <image> backdrop;
    in property <image> hero_poster;
    in property <bool> series_details_visible: false;
    in property <[TvDetailItem]> detail_items;
    in property <string> first_file_id;
    in property <bool> has_hero_badges: false;
    in property <[TvSeasonTab]> seasons;
    in-out property <int> selected_season_idx: 0;
    in property <string> season_block_title;
    in property <string> season_block_meta;
    in property <string> season_block_overview;
    in property <image> season_block_poster;
    in property <[TvEpisodeRow]> episodes;

    callback back_clicked();
    callback season_changed(int);
    callback play_episode(string);
    callback subtitles_clicked(string);
    callback episode_watch_toggle(string);

    private property <bool> compact: root.width < 760px;
    private property <length> gutter: compact ? 20px : 48px;
    private property <length> content-w: root.width - gutter * 2;
    private property <length> hero-band-h: compact ? 440px : min(max(root.height * 58 / 100, 460px), 640px);
    private property <length> hero-col-w: min(root.width - gutter * 2, 820px);
    private property <length> overview-max-w: min(680px, hero-col-w);
    private property <length> episode-still-w: compact ? 100px : 128px;
    private property <length> episode-action-w: compact ? 156px : 236px;

    ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, content.preferred-height + 24px);

        content := VerticalLayout {
            width: root.width;
            spacing: 0px;

            // ── Hero ──────────────────────────────────────────────────────────
            Rectangle {
                width: parent.width;
                height: hero-band-h;
                clip: true;

                if backdrop.width > 0 : Image {
                    width: parent.width;
                    height: parent.height;
                    y: 0px;
                    source: root.backdrop;
                    image-fit: cover;
                }

                if backdrop.width == 0 : Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(165deg, Theme.surface_higher 0%, #050508 100%);
                    if hero_poster.width > 0 : Image {
                        width: parent.width;
                        height: parent.height;
                        y: 0px;
                        source: root.hero_poster;
                        image-fit: cover;
                        opacity: 0.35;
                    }
                }

                // Left-side darkness so text is legible against any backdrop
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(90deg, #07070de8 0%, #07070dc0 30%, #07070d60 65%, #07070d00 100%);
                }

                // Bottom vignette blending into page bg
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(180deg, #00000000 0%, #00000030 50%, Theme.bg 100%);
                }

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding-left: gutter;
                    padding-right: gutter;
                    padding-bottom: compact ? 32px : 56px;
                    padding-top: 0px;
                    alignment: end;

                    VerticalLayout {
                        spacing: compact ? 10px : 14px;
                        width: min(hero-col-w, parent.width);
                        alignment: start;

                        // Back button
                        Rectangle {
                            width: 120px;
                            height: 22px;
                            background: transparent;

                            Icon {
                                x: 0px;
                                y: (parent.height - self.height) / 2 + 1px;
                                name: "arrow-left";
                                icon_size: 11px;
                                tint: Theme.accent_hi;
                            }

                            Text {
                                x: 17px;
                                y: (parent.height - self.height) / 2;
                                text: "Back to Media";
                                color: Theme.accent_hi;
                                font-size: 12.5px;
                                font-weight: 600;
                                font-family: Theme.ui_font;
                            }

                            TouchArea {
                                clicked => { root.back_clicked(); }
                            }
                        }

                        // Title
                        Text {
                            text: root.title;
                            color: Theme.text;
                            font-size: compact ? 28px : 40px;
                            font-weight: 800;
                            letter-spacing: -0.8px;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }

                        if tagline != "" : Text {
                            text: root.tagline;
                            color: Theme.accent;
                            font-size: compact ? 14px : 15px;
                            font-weight: 500;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }

                        // Meta row: ⭐ rating · years · stats
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            Icon {
                                name: "star";
                                icon_size: 13px;
                                tint: Theme.accent;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.rating_label;
                                color: Theme.text;
                                font-size: compact ? 13px : 14px;
                                font-weight: 700;
                                font-family: Theme.mono_font;
                            }

                            if years_label != "" : Text {
                                text: "  ·  " + root.years_label;
                                color: Theme.text_dim;
                                font-size: compact ? 13px : 14px;
                                font-weight: 500;
                                font-family: Theme.ui_font;
                            }

                            if stats_line != "" : Text {
                                text: "  ·  " + root.stats_line;
                                color: Theme.text_dim;
                                font-size: compact ? 13px : 14px;
                                font-weight: 500;
                                font-family: Theme.ui_font;
                            }
                        }

                        // Overview
                        if overview != "" : Text {
                            width: min(overview-max-w, parent.width);
                            text: root.overview;
                            color: Theme.text_dim;
                            font-size: compact ? 13.5px : 14.5px;
                            wrap: word-wrap;
                            font-family: Theme.ui_font;
                        }

                        // Genre / status badges
                        if has_hero_badges : HorizontalLayout {
                            spacing: 8px;
                            width: parent.width;
                            alignment: start;

                            for tag in root.hero_badges: HeroPill {
                                badge: tag;
                            }
                        }

                        // Play button
                        if first_file_id != "" : Rectangle {
                            width: 96px;
                            height: 40px;
                            border-radius: 8px;
                            background: Theme.text;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 7px;
                                width: parent.width;
                                height: parent.height;

                                Icon {
                                    name: "play";
                                    icon_size: 13px;
                                    tint: Theme.bg;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: "Play";
                                    color: Theme.bg;
                                    font-size: 14px;
                                    font-weight: 700;
                                    font-family: Theme.ui_font;
                                    height: parent.height;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                clicked => { root.play_episode(root.first_file_id); }
                            }
                        }
                    }
                }
            }

            // ── Series details ────────────────────────────────────────────────
            if root.series_details_visible : VerticalLayout {
                width: root.width;
                padding-top: 24px;
                padding-bottom: 20px;
                spacing: 14px;

                // 6 paired columns centred across the full window width
                if root.detail_items.length >= 12 : HorizontalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 0px;
                        width: content-w;

                        DetailColumn { label1: root.detail_items[0].label; value1: root.detail_items[0].value; label2: root.detail_items[6].label; value2: root.detail_items[6].value; }
                        DetailColumn { label1: root.detail_items[1].label; value1: root.detail_items[1].value; label2: root.detail_items[7].label; value2: root.detail_items[7].value; }
                        DetailColumn { label1: root.detail_items[2].label; value1: root.detail_items[2].value; label2: root.detail_items[8].label; value2: root.detail_items[8].value; }
                        DetailColumn { label1: root.detail_items[3].label; value1: root.detail_items[3].value; label2: root.detail_items[9].label; value2: root.detail_items[9].value; }
                        DetailColumn { label1: root.detail_items[4].label; value1: root.detail_items[4].value; label2: root.detail_items[10].label; value2: root.detail_items[10].value; }
                        DetailColumn { label1: root.detail_items[5].label; value1: root.detail_items[5].value; label2: root.detail_items[11].label; value2: root.detail_items[11].value; }
                    }
                }

                // Divider
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: content-w;
                        height: 1px;
                        background: Theme.border;
                    }
                }
            }

            // ── Seasons & Episodes ────────────────────────────────────────────
            VerticalLayout {
                width: parent.width;
                padding-left: gutter;
                padding-right: gutter;
                padding-top: 28px;
                padding-bottom: 48px;
                spacing: 18px;

                Text {
                    text: "Seasons & Episodes";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 600;
                    letter-spacing: -0.3px;
                    font-family: Theme.ui_font;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    for tab[idx] in root.seasons: ButtonChip {
                        label: tab.label;
                        primary: idx == root.selected_season_idx;
                        clicked => {
                            root.selected_season_idx = idx;
                            root.season_changed(idx);
                        }
                    }
                }

                if season_block_title != "" || season_block_meta != "" : Rectangle {
                    width: content-w;
                    background: Theme.surface;
                    border-radius: Theme.radius_lg;
                    border-width: 1px;
                    border-color: Theme.border;

                    HorizontalLayout {
                        padding: 14px;
                        spacing: 14px;
                        alignment: start;
                        width: parent.width;

                        Rectangle {
                            width: 72px;
                            height: 108px;
                            border-radius: 6px;
                            clip: true;
                            background: Theme.surface_higher;
                            border-width: 1px;
                            border-color: Theme.border;

                            if season_block_poster.width > 0 : Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.season_block_poster;
                                image-fit: cover;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 6px;
                            alignment: start;

                            Text {
                                text: root.season_block_title;
                                color: Theme.text;
                                font-size: 15px;
                                font-weight: 700;
                                wrap: word-wrap;
                                font-family: Theme.ui_font;
                            }

                            Text {
                                text: root.season_block_meta;
                                color: Theme.text_dim;
                                font-size: 12.5px;
                                wrap: word-wrap;
                                font-family: Theme.ui_font;
                            }

                            if season_block_overview != "" : Text {
                                text: root.season_block_overview;
                                color: Theme.text_dim;
                                font-size: 14px;
                                wrap: word-wrap;
                                font-family: Theme.ui_font;
                            }
                        }
                    }
                }

                VerticalLayout {
                    width: content-w;
                    spacing: 12px;

                    for ep[idx] in root.episodes: Rectangle {
                        width: parent.width;
                        background: Theme.surface;
                        border-radius: Theme.radius_lg;
                        border-width: 1px;
                        border-color: Theme.border;
                        clip: true;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 14px;

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;
                                width: content-w - 28px;

                                Rectangle {
                                    width: episode-still-w;
                                    height: compact ? 56px : 80px;
                                    vertical-stretch: 0;
                                    border-radius: 6px;
                                    clip: true;
                                    background: Theme.surface_higher;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    if ep.still.width > 0 : Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: ep.still;
                                        image-fit: cover;
                                    }
                                }

                                VerticalLayout {
                                    width: max(160px, content-w - 28px - episode-still-w - episode-action-w - 28px);
                                    spacing: 10px;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;

                                        Text {
                                            horizontal-stretch: 1;
                                            text: ep.ep_num + ". " + ep.title;
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                            font-family: Theme.ui_font;
                                        }

                                        Rectangle {
                                            width: 24px;
                                            height: 24px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: ep.watched ? #22c55ecc : #ffffff40;
                                            background: ep.watched ? #22c55e : #000000aa;

                                            Icon {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                name: "check";
                                                icon_size: 12px;
                                                tint: ep.watched ? Theme.bg : Theme.text_dim;
                                            }

                                            TouchArea {
                                                clicked => {
                                                    root.episode_watch_toggle(ep.file_id);
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        if ep.air_date != "" : Text {
                                            color: Theme.text_mute;
                                            font-size: 11.5px;
                                            font-family: Theme.ui_font;
                                            text: ep.air_date;
                                        }

                                        if ep.air_date != "" && (ep.duration_label != "" || ep.rating_label != "") : Text {
                                            color: Theme.text_mute;
                                            font-size: 11.5px;
                                            font-family: Theme.ui_font;
                                            text: "·";
                                        }

                                        if ep.duration_label != "" : HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            Icon {
                                                name: "clock";
                                                icon_size: 11px;
                                                tint: Theme.text_mute;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                color: Theme.text_mute;
                                                font-size: 11.5px;
                                                font-family: Theme.ui_font;
                                                text: ep.duration_label;
                                            }
                                        }

                                        if ep.duration_label != "" && ep.rating_label != "" : Text {
                                            color: Theme.text_mute;
                                            font-size: 11.5px;
                                            font-family: Theme.ui_font;
                                            text: "·";
                                        }

                                        if ep.rating_label != "" : HorizontalLayout {
                                            spacing: 4px;
                                            alignment: center;

                                            Icon {
                                                name: "star";
                                                icon_size: 11px;
                                                tint: Theme.accent;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            Text {
                                                color: Theme.text_dim;
                                                font-size: 11.5px;
                                                font-family: Theme.mono_font;
                                                text: ep.rating_label;
                                            }
                                        }
                                    }

                                    Text {
                                        text: ep.overview;
                                        color: Theme.text_dim;
                                        font-size: 12.5px;
                                        wrap: word-wrap;
                                        font-family: Theme.ui_font;
                                    }
                                }

                                HorizontalLayout {
                                    width: episode-action-w;
                                    spacing: 8px;
                                    alignment: end;

                                    if ep.file_id != "" : ButtonChip {
                                        primary: true;
                                        label: "Play";
                                        icon_name: "play";
                                        clicked => { root.play_episode(ep.file_id); }
                                    }

                                    if ep.file_id != "" : ButtonChip {
                                        primary: false;
                                        label: "Subtitles";
                                        icon_name: "subtitles";
                                        clicked => { root.subtitles_clicked(ep.file_id); }
                                    }
                                }
                            }

                            if ep.credits.length > 0 : VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "Guest Stars & Crew";
                                    color: Theme.text_mute;
                                    font-size: 10px;
                                    font-weight: 700;
                                    letter-spacing: 0.6px;
                                    font-family: Theme.ui_font;
                                }

                                Flickable {
                                    height: 120px;
                                    viewport-width: parent.width;

                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;

                                        for credit[idx] in ep.credits: EpisodeCreditCard {
                                            credit: credit;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
