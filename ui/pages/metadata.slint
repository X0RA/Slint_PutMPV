import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { MetadataItem } from "../types.slint";
import { ButtonChip, StatusBadge, IconButton, RefreshIconButton } from "../components/primitives.slint";
import { Icon } from "../components/icons.slint";

component SelectMark inherits Rectangle {
    in property <bool> selected: false;
    callback clicked();

    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: 1.5px;
    border-color: selected ? Theme.accent : Theme.border_hi;
    background: selected ? Theme.accent : transparent;

    if (root.selected) : check := Icon {
        x: 3px;
        y: 3px;
        name: "check";
        icon_size: 10px;
        tint: Theme.bg;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component SegmentedChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 26px;
    width: label-text.preferred-width + 22px;
    border-radius: 5px;
    background: active ? Theme.accent_soft : transparent;

    states [
        hover when touch.has-hover && !active : {
            background: #ffffff08;
        }
    ]

    label-text := Text {
        x: 11px;
        y: 0px;
        height: parent.height;
        text: root.label;
        color: active ? Theme.accent_hi : Theme.text_dim;
        font-size: 12px;
        font-weight: 500;
        font-family: Theme.ui_font;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component GroupHeader inherits Rectangle {
    in property <string> label;
    in property <int> count: 0;
    in property <bool> open: true;
    callback clicked();

    height: 26px;
    background: transparent;

    Icon {
        x: 2px;
        y: (parent.height - self.height) / 2;
        name: root.open ? "chevron-down" : "chevron-right";
        icon_size: 11px;
        tint: Theme.text_dim;
    }

    label-text := Text {
        x: 20px;
        y: 0px;
        height: parent.height;
        text: root.label;
        color: Theme.text_dim;
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: 1.5px;
        font-family: Theme.ui_font;
        vertical-alignment: center;
    }

    Text {
        x: 20px + label-text.preferred-width + 8px;
        y: 0px;
        height: parent.height;
        text: root.count;
        color: Theme.text_mute;
        font-size: 10.5px;
        font-weight: 600;
        font-family: Theme.mono_font;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.clicked(); }
    }
}

component EpisodeRow inherits Rectangle {
    in property <MetadataItem> item;
    /// When false, row takes no space (used to filter episodes in a nested model loop).
    in property <bool> active: true;

    private property <length> side-pad: 14px;
    private property <length> label-block-w: 90px;

    height: root.active && item.media_type == "Episode" ? 34px : 0px;
    background: transparent;

    if (root.active && root.item.media_type == "Episode") : Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    if (root.active && root.item.media_type == "Episode") : Text {
        x: side-pad;
        y: 0px;
        height: parent.height;
        text: "S";
        color: Theme.text_mute;
        font-size: 10px;
        font-family: Theme.mono_font;
        vertical-alignment: center;
    }

    if (root.active && root.item.media_type == "Episode") : Text {
        x: side-pad + 18px;
        y: 0px;
        height: parent.height;
        text: root.item.season;
        color: Theme.text;
        font-size: 11px;
        font-weight: 600;
        font-family: Theme.mono_font;
        vertical-alignment: center;
    }

    if (root.active && root.item.media_type == "Episode") : Text {
        x: side-pad + 40px;
        y: 0px;
        height: parent.height;
        text: "E";
        color: Theme.text_mute;
        font-size: 10px;
        font-family: Theme.mono_font;
        vertical-alignment: center;
    }

    if (root.active && root.item.media_type == "Episode") : Text {
        x: side-pad + 58px;
        y: 0px;
        height: parent.height;
        text: root.item.episode < 10 ? "0" + root.item.episode : root.item.episode;
        color: Theme.text;
        font-size: 11px;
        font-weight: 600;
        font-family: Theme.mono_font;
        vertical-alignment: center;
    }

    if (root.active && root.item.media_type == "Episode") : Text {
        x: side-pad + label-block-w;
        y: 0px;
        width: parent.width - side-pad * 2 - label-block-w - 96px;
        height: parent.height;
        text: root.item.filename;
        color: Theme.text_dim;
        font-size: 11.5px;
        font-family: Theme.ui_font;
        overflow: elide;
        vertical-alignment: center;
    }

    if (root.active && root.item.media_type == "Episode") : StatusBadge {
        x: parent.width - self.width - side-pad;
        y: (parent.height - self.height) / 2;
        label: root.item.badge == "" ? "Parsed" : root.item.badge;
        positive: true;
    }
}

component TvRow inherits Rectangle {
    in property <MetadataItem> item;
    callback toggle_item(id: int);
    callback toggle_expand(id: int);

    height: item.media_type == "TV" ? 60px : 0px;
    background: transparent;

    if (root.item.media_type == "TV") : row := Rectangle {
        width: parent.width;
        height: 60px;
        background: item.selected ? Theme.accent_soft : transparent;

        Rectangle {
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: Theme.border;
        }

        SelectMark {
            x: 16px;
            y: (parent.height - self.height) / 2;
            selected: root.item.selected;
            clicked => { root.toggle_item(root.item.id); }
        }

        title-text := Text {
            x: 46px;
            y: 12px;
            width: parent.width - 46px - 220px;
            text: root.item.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            font-family: Theme.ui_font;
            overflow: elide;
        }

        Text {
            x: 46px;
            y: 32px;
            width: parent.width - 46px - 220px;
            text: root.item.subtitle;
            color: Theme.text_mute;
            font-size: 11.5px;
            font-family: Theme.ui_font;
            overflow: elide;
        }

        Text {
            x: parent.width - 200px;
            y: 0px;
            height: parent.height;
            text: "TV";
            color: Theme.text_mute;
            font-size: 10.5px;
            font-family: Theme.mono_font;
            vertical-alignment: center;
        }

        StatusBadge {
            x: parent.width - 150px;
            y: (parent.height - self.height) / 2;
            label: root.item.matched ? "Matched" : "Unmatched";
            positive: root.item.matched;
        }

        Icon {
            x: parent.width - 22px;
            y: (parent.height - self.height) / 2;
            name: root.item.expanded ? "chevron-down" : "chevron-right";
            icon_size: 13px;
            tint: Theme.text_mute;
        }

        TouchArea {
            x: 42px;
            width: parent.width - 42px;
            height: parent.height;
            clicked => { root.toggle_expand(root.item.id); }
        }
    }

}

component MovieRow inherits Rectangle {
    in property <MetadataItem> item;
    callback toggle_item(id: int);

    height: item.media_type == "Movie" ? 60px : 0px;
    background: root.item.selected ? Theme.accent_soft : transparent;

    if (root.item.media_type == "Movie") : divider := Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    if (root.item.media_type == "Movie") : select-mark := SelectMark {
        x: 16px;
        y: (parent.height - self.height) / 2;
        selected: root.item.selected;
        clicked => { root.toggle_item(root.item.id); }
    }

    if (root.item.media_type == "Movie") : title := Text {
        x: 46px;
        y: 12px;
        width: parent.width - 46px - 220px;
        text: root.item.title;
        color: Theme.text;
        font-size: 13px;
        font-weight: 600;
        font-family: Theme.ui_font;
        overflow: elide;
    }

    if (root.item.media_type == "Movie") : subtitle := Text {
        x: 46px;
        y: 32px;
        width: parent.width - 46px - 220px;
        text: root.item.subtitle;
        color: Theme.text_mute;
        font-size: 11px;
        font-family: Theme.mono_font;
        overflow: elide;
    }

    if (root.item.media_type == "Movie") : media-type := Text {
        x: parent.width - 200px;
        y: 0px;
        height: parent.height;
        text: "Movie";
        color: Theme.text_dim;
        font-size: 10.5px;
        font-family: Theme.mono_font;
        vertical-alignment: center;
    }

    if (root.item.media_type == "Movie") : badge := StatusBadge {
        x: parent.width - 150px;
        y: (parent.height - self.height) / 2;
        label: root.item.matched ? "Matched" : "Unmatched";
        positive: root.item.matched;
    }

    if (root.item.media_type == "Movie") : touch := TouchArea {
        x: 42px;
        width: parent.width - 42px;
        height: parent.height;
        clicked => { root.toggle_item(root.item.id); }
    }
}

export component MetadataPage inherits Rectangle {
    in property <[MetadataItem]> items;
    in property <int> total_count: 0;
    in property <int> selected_count: 0;
    in property <int> unmatched_count: 0;
    in property <int> tv_count: 0;
    in property <int> movie_count: 0;
    in property <string> status: "";
    in property <bool> busy: false;
    in-out property <string> query;
    in-out property <int> filter_index;
    in-out property <bool> hide_matched;
    callback criteria_changed();
    callback toggle_item(id: int);
    callback toggle_expand(id: int);
    callback select_unmatched();
    callback clear_selection();
    callback fetch_metadata();

    background: Theme.bg;

    private property <length> page_padding: self.width >= 980px ? 32px : 20px;
    private property <length> header_bottom: 154px;
    private property <bool> tv_open: true;
    private property <bool> movie_open: true;

    title-text := Text {
        x: page_padding;
        y: 24px;
        text: "Metadata";
        color: Theme.text;
        font-size: 26px;
        font-weight: 600;
        font-family: Theme.ui_font;
    }

    RefreshIconButton {
        x: page_padding + title-text.preferred-width + 10px;
        y: title-text.y + (title-text.preferred-height - self.height) / 2;
        tint: Theme.text_mute;
        clicked => { root.criteria_changed(); }
    }

    Text {
        x: page_padding;
        y: 60px;
        width: parent.width - page_padding * 2 - 170px;
        text: root.status == "" ? "Match your files with TMDB · " + total_count + " items catalogued" : root.status;
        color: Theme.text_dim;
        font-size: 12.5px;
        font-family: Theme.ui_font;
        overflow: elide;
    }

    stats := Rectangle {
        x: parent.width - page_padding - self.width;
        y: 24px;
        width: 160px;
        height: 46px;
        background: transparent;
        opacity: root.width < 860px ? 0 : 1;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 26px;
            text: selected_count + " selected";
            color: Theme.text;
            font-size: 18px;
            font-weight: 500;
            font-family: Theme.ui_font;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            y: 28px;
            width: parent.width;
            text: unmatched_count + " UNMATCHED";
            color: Theme.text_mute;
            font-size: 10.5px;
            font-family: Theme.mono_font;
            horizontal-alignment: right;
        }
    }

    toolbar := Rectangle {
        x: page_padding;
        y: 96px;
        width: parent.width - page_padding * 2;
        height: 34px;
        background: transparent;

        filter-segment := Rectangle {
            x: 0px;
            y: 0px;
            width: all-chip.width + tv-chip.width + mv-chip.width + 14px;
            height: 34px;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;

            all-chip := SegmentedChip {
                x: 3px;
                y: 4px;
                label: "All Media";
                active: root.filter_index == 0;
                clicked => { root.filter_index = 0; root.criteria_changed(); }
            }

            tv-chip := SegmentedChip {
                x: all-chip.width + 5px;
                y: 4px;
                label: "TV Shows";
                active: root.filter_index == 1;
                clicked => { root.filter_index = 1; root.criteria_changed(); }
            }

            mv-chip := SegmentedChip {
                x: all-chip.width + tv-chip.width + 7px;
                y: 4px;
                label: "Movies";
                active: root.filter_index == 2;
                clicked => { root.filter_index = 2; root.criteria_changed(); }
            }
        }

        hide-chip := ButtonChip {
            x: filter-segment.width + 10px;
            y: 1px;
            height: 32px;
            label: "Hide Matched";
            icon_name: "check";
            active: root.hide_matched;
            clicked => { root.hide_matched = !root.hide_matched; root.criteria_changed(); }
        }

        select-chip := ButtonChip {
            x: hide-chip.x + hide-chip.width + 8px;
            y: 1px;
            height: 32px;
            label: "Select Unmatched";
            clicked => { root.select_unmatched(); }
        }

        clear-chip := ButtonChip {
            x: select-chip.x + select-chip.width + 8px;
            y: 1px;
            height: 32px;
            label: "Clear Selection";
            clicked => { root.clear_selection(); }
        }

        fetch-chip := ButtonChip {
            x: clear-chip.x + clear-chip.width + 8px;
            y: 1px;
            height: 32px;
            label: root.busy ? "Fetching..." : "Fetch Metadata";
            icon_name: "refresh";
            primary: true;
            enabled: root.selected_count > 0 && !root.busy;
            clicked => { root.fetch_metadata(); }
        }

    }

    content := ScrollView {
        x: page_padding;
        y: root.header_bottom;
        width: parent.width - page_padding * 2;
        height: parent.height - root.header_bottom - 18px;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, content-column.preferred-height + 24px);

        content-column := VerticalLayout {
            width: parent.width;
            spacing: 20px;

            if (root.filter_index == 0 || root.filter_index == 1) : tv-section := VerticalLayout {
                width: parent.width;
                spacing: 6px;

                tv-header := GroupHeader {
                    width: parent.width;
                    label: "TV SHOWS";
                    count: root.tv_count;
                    open: root.tv_open;
                    clicked => { root.tv_open = !root.tv_open; }
                }

                if (root.tv_open) : tv-box := Rectangle {
                    width: parent.width;
                    height: tv-list.preferred-height;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface;
                    clip: true;

                    tv-list := VerticalLayout {
                        width: parent.width;
                        spacing: 0px;

                        for show in root.items : VerticalLayout {
                            width: parent.width;
                            spacing: 0px;

                            if (show.media_type == "TV") : TvRow {
                                item: show;
                                toggle_item(id) => { root.toggle_item(id); }
                                toggle_expand(id) => { root.toggle_expand(id); }
                            }

                            if (show.media_type == "TV" && show.expanded) : VerticalLayout {
                                width: parent.width;
                                spacing: 0px;

                                for ep in root.items : EpisodeRow {
                                    item: ep;
                                    active: ep.media_type == "Episode" && ep.parent_id == show.id;
                                }
                            }
                        }
                    }
                }
            }

            if (root.filter_index == 0 || root.filter_index == 2) : movie-section := VerticalLayout {
                width: parent.width;
                spacing: 6px;

                movie-header := GroupHeader {
                    width: parent.width;
                    label: "MOVIES";
                    count: root.movie_count;
                    open: root.movie_open;
                    clicked => { root.movie_open = !root.movie_open; }
                }

                if (root.movie_open) : movie-box := Rectangle {
                    width: parent.width;
                    height: movie-list.preferred-height;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface;
                    clip: true;

                    movie-list := VerticalLayout {
                        width: parent.width;
                        spacing: 0px;

                        for item in root.items : MovieRow {
                            item: item;
                            toggle_item(id) => { root.toggle_item(id); }
                        }
                    }
                }
            }
        }
    }
}
