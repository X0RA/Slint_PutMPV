import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SidebarSectionButton, ButtonChip, TextFieldBox, RadioRow, Dropdown } from "../components/primitives.slint";
import { MetadataSettingsPanel } from "../components/settings/metadata.slint";
import { WatchSyncSettingsPanel } from "../components/settings/watch-sync.slint";
import { LocalDataRow, MetadataItem } from "../types.slint";

component SettingsHead inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 6px;
    Text { text: root.title; color: Theme.text; font-size: 22px; font-weight: 600; font-family: Theme.ui_font; }
    Text { text: root.description; color: Theme.text_dim; font-size: 13px; font-family: Theme.ui_font; wrap: word-wrap; }
}

component CardHeader inherits Rectangle {
    in property <string> title;
    in property <string> description;
    height: layout.preferred-height;
    background: transparent;
    layout := VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 4px;
        Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; font-family: Theme.ui_font; }
        if (root.description != "") : Text { text: root.description; color: Theme.text_dim; font-size: 12px; font-family: Theme.ui_font; wrap: word-wrap; }
    }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> show_divider: true;
    height: layout.preferred-height;
    background: transparent;
    layout := HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 24px;
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            alignment: start;
            Text { text: root.label; color: Theme.text; font-size: 12.5px; font-weight: 500; font-family: Theme.ui_font; }
            if (root.hint != "") : Text { text: root.hint; color: Theme.text_mute; font-size: 11.5px; font-family: Theme.ui_font; wrap: word-wrap; }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: end;
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                @children
            }
        }
    }
    if (root.show_divider) : Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

component InfoBanner inherits Rectangle {
    in property <string> title;
    in property <string> body;
    height: body-layout.preferred-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: #fbbf2433;
    background: #fbbf2410;
    body-layout := VerticalLayout {
        width: parent.width;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 6px;
        Text { text: root.title; color: Theme.warning; font-size: 11.5px; font-weight: 600; font-family: Theme.ui_font; }
        Text { text: root.body; color: Theme.warning; font-size: 11.5px; font-family: Theme.ui_font; wrap: word-wrap; }
    }
}

component SectionContainer inherits VerticalLayout {
    spacing: 16px;
    padding-top: 32px;
    padding-bottom: 40px;
    padding-left: 44px;
    padding-right: 44px;
}

component DataRow inherits Rectangle {
    in property <string> name;
    in property <string> desc;
    in property <string> path;
    in property <bool> enabled: true;
    in property <bool> last: false;
    callback clear();
    height: row-layout.preferred-height;
    background: transparent;
    opacity: enabled ? 1 : 0.55;
    row-layout := HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 20px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.name; color: Theme.text; font-size: 12.5px; font-weight: 500; font-family: Theme.ui_font; }
            Text { text: root.desc; color: Theme.text_dim; font-size: 11.5px; font-family: Theme.ui_font; wrap: word-wrap; }
            Text { text: root.path; color: Theme.text_mute; font-size: 10.5px; font-family: Theme.mono_font; overflow: elide; }
        }
        VerticalLayout {
            alignment: start;
            ButtonChip { label: "Clear"; icon_name: "trash"; danger: true; enabled: root.enabled; clicked => { root.clear(); } }
        }
    }
    if (!root.last) : Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

export component SettingsPage inherits Rectangle {
    in-out property <int> section: 0;

    in-out property <string> tmdb_local_key;
    in-out property <string> tmdb_putio_key;
    in-out property <int> tmdb_source: 0;
    in-out property <string> tmdb_status;

    in-out property <[string]> sync_profile_labels;
    in-out property <int> sync_existing_index: -1;
    in-out property <bool> sync_dropdown_open: false;
    in-out property <string> sync_new_name;
    in-out property <string> sync_status;
    in-out property <int> sync_played_count: 0;
    in-out property <int> sync_known_count: 0;
    in-out property <string> sync_active_profile;

    in property <[LocalDataRow]> local_data_rows;
    in-out property <bool> confirm_open: false;
    in-out property <string> local_data_status;

    in property <[MetadataItem]> metadata_items;
    in property <int> metadata_total_count: 0;
    in property <int> metadata_selected_count: 0;
    in property <int> metadata_unmatched_count: 0;
    in property <int> metadata_tv_count: 0;
    in property <int> metadata_movie_count: 0;
    in property <string> metadata_status: "";
    in property <bool> metadata_busy: false;
    in property <bool> auto_metadata_fetch_enabled: false;
    in-out property <string> metadata_query;
    in-out property <int> metadata_filter_index;
    in-out property <bool> metadata_hide_matched;

    callback settings_refresh();
    callback tmdb_source_changed(source: int);
    callback tmdb_save_local();
    callback tmdb_replace_putio();
    callback tmdb_delete_putio();
    callback sync_profile_selected(index: int);
    callback sync_refresh_profiles();
    callback sync_use_existing();
    callback sync_use_new();
    callback sync_now();
    callback sync_disable();
    callback local_data_clear(index: int);
    callback local_data_confirm_clear();
    callback local_data_cancel_clear();
    callback metadata_criteria_changed();
    callback metadata_toggle_item(id: int);
    callback metadata_toggle_expand(id: int);
    callback metadata_select_unmatched();
    callback metadata_clear_selection();
    callback metadata_fetch();
    callback auto_metadata_fetch_changed(bool);

    background: Theme.bg;

    sidebar := Rectangle {
        x: 0px;
        y: 0px;
        width: 240px;
        height: parent.height;
        background: Theme.bg;
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.border; }
        VerticalLayout {
            x: 16px;
            y: 0px;
            width: parent.width - 32px;
            height: parent.height;
            spacing: 0px;
            padding-top: 28px;
            padding-bottom: 20px;
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 16px;
                spacing: 3px;
                Text { text: "Settings"; color: Theme.text; font-size: 22px; font-weight: 600; font-family: Theme.ui_font; }
                Text { text: "Version 1.0.0"; color: Theme.text_mute; font-size: 11.5px; font-family: Theme.ui_font; }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle { height: 12px; }
            SidebarSectionButton { label: "Configuration"; subtitle: "TMDB metadata"; icon_name: "settings"; active: root.section == 0; clicked => { root.section = 0; root.settings_refresh(); } }
            Rectangle { height: 2px; }
            SidebarSectionButton { label: "Watch Sync"; subtitle: "Status & shared profiles"; icon_name: "refresh"; active: root.section == 1; clicked => { root.section = 1; root.settings_refresh(); root.sync_refresh_profiles(); } }
            Rectangle { height: 2px; }
            SidebarSectionButton { label: "Metadata"; subtitle: "Match files with TMDB"; icon_name: "metadata"; active: root.section == 3; clicked => { root.section = 3; root.metadata_criteria_changed(); } }
            Rectangle { height: 2px; }
            SidebarSectionButton { label: "Local Data"; subtitle: "Caches & stores"; icon_name: "document"; active: root.section == 2; clicked => { root.section = 2; root.settings_refresh(); } }
            Rectangle { vertical-stretch: 1; }
        }
    }

    if (root.section == 3) : metadata-page := MetadataSettingsPanel {
        x: 240px;
        y: 0px;
        width: parent.width - 240px;
        height: parent.height;
        items: root.metadata_items;
        query <=> root.metadata_query;
        filter_index <=> root.metadata_filter_index;
        hide_matched <=> root.metadata_hide_matched;
        total_count: root.metadata_total_count;
        selected_count: root.metadata_selected_count;
        unmatched_count: root.metadata_unmatched_count;
        tv_count: root.metadata_tv_count;
        movie_count: root.metadata_movie_count;
        status: root.metadata_status;
        busy: root.metadata_busy;
        auto_fetch_enabled: root.auto_metadata_fetch_enabled;
        toggle_item(id) => { root.metadata_toggle_item(id); }
        toggle_expand(id) => { root.metadata_toggle_expand(id); }
        select_unmatched => { root.metadata_select_unmatched(); }
        clear_selection => { root.metadata_clear_selection(); }
        fetch_metadata => { root.metadata_fetch(); }
        criteria_changed => { root.metadata_criteria_changed(); }
        auto_fetch_changed(enabled) => { root.auto_metadata_fetch_changed(enabled); }
    }

    content := ScrollView {
        x: 240px;
        y: 0px;
        width: parent.width - 240px;
        height: parent.height;
        visible: root.section != 3;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, current-section.preferred-height);

        current-section := VerticalLayout {
            width: parent.width;
            spacing: 0px;
            alignment: start;

            if (root.section == 0) : config-page := SectionContainer {
                SettingsHead { title: "Configuration"; description: "TMDB metadata can use a local key or a shared key stored on put.io."; }
                Rectangle { height: 8px; }
                Rectangle {
                    height: tmdb-card.preferred-height;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface;
                    clip: true;
                    tmdb-card := VerticalLayout {
                        width: parent.width;
                        spacing: 0px;
                        CardHeader { title: "TMDB Metadata"; description: "Choose which TMDB key PutMPV should use for metadata requests."; }
                        SettingsRow {
                            label: "Key source";
                            hint: "Local stays on this device. Put.io shared follows your account.";
                            HorizontalLayout {
                                spacing: 16px;
                                RadioRow { label: "Local key"; checked: root.tmdb_source == 0; clicked => { root.tmdb_source = 0; root.tmdb_source_changed(0); } }
                                RadioRow { label: "Put.io shared key"; checked: root.tmdb_source == 1; clicked => { root.tmdb_source = 1; root.tmdb_source_changed(1); } }
                            }
                        }
                        SettingsRow {
                            label: "Local Key";
                            hint: "Stored on this device only.";
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                TextFieldBox { width: 300px; placeholder: "Enter your TMDB key"; monospace: true; text <=> root.tmdb_local_key; }
                                ButtonChip { width: replace-btn.width; label: "Save"; primary: true; center_content: true; clicked => { root.tmdb_save_local(); } }
                                ButtonChip { icon_name: "trash"; danger: true; clicked => { root.tmdb_delete_putio(); } }
                            }
                        }
                        SettingsRow {
                            label: "Put.io Shared Key";
                            hint: "Cached from your put.io account config.";
                            show_divider: false;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                TextFieldBox { width: 300px; text: root.tmdb_putio_key == "" ? "" : "........................"; placeholder: "No shared key found"; monospace: true; read_only: true; }
                                replace-btn := ButtonChip { label: "Replace"; icon_name: "arrow-up"; primary: true; center_content: true; clicked => { root.tmdb_replace_putio(); } }
                                ButtonChip { icon_name: "trash"; danger: true; clicked => { root.tmdb_delete_putio(); } }
                            }
                        }
                    }
                }
                if (root.tmdb_status != "") : InfoBanner { title: "TMDB"; body: root.tmdb_status; }
            }

            if (root.section == 1) : sync-page := WatchSyncSettingsPanel {
                profile_labels: root.sync_profile_labels;
                existing_index <=> root.sync_existing_index;
                dropdown_open <=> root.sync_dropdown_open;
                new_name <=> root.sync_new_name;
                status: root.sync_status;
                played_count: root.sync_played_count;
                known_count: root.sync_known_count;
                active_profile: root.sync_active_profile;
                profile_selected(index) => { root.sync_profile_selected(index); }
                use_existing => { root.sync_use_existing(); }
                use_new => { root.sync_use_new(); }
                sync_now => { root.sync_now(); }
                disable_sync => { root.sync_disable(); }
            }

            if (root.section == 2) : data-page := SectionContainer {
                SettingsHead { title: "Local Data & Configuration"; description: "Filesystem paths for each JSON store. Clear caches or reset app configuration independently."; }
                Rectangle { height: 8px; }
                Rectangle {
                    height: data-card.preferred-height;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.surface;
                    clip: true;
                    data-card := VerticalLayout {
                        spacing: 0px;
                        for row[index] in root.local_data_rows : DataRow {
                            name: row.name;
                            desc: row.desc;
                            path: row.path;
                            enabled: row.enabled;
                            last: index == root.local_data_rows.length - 1;
                            clear => { root.local_data_clear(index); }
                        }
                    }
                }
                InfoBanner { title: "Warning."; body: "Clearing data cannot be undone. The application will need to rebuild caches and re-fetch metadata as needed."; }
                if (root.local_data_status != "") : InfoBanner { title: "Local data"; body: root.local_data_status; }
            }
        }
    }

    if (root.confirm_open) : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #00000099;
        Rectangle {
            width: 360px;
            height: dialog-layout.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border_hi;
            background: Theme.surface;
            dialog-layout := VerticalLayout {
                width: parent.width;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 18px;
                padding-bottom: 18px;
                spacing: 14px;
                Text { text: "Clear app config?"; color: Theme.text; font-size: 15px; font-weight: 600; font-family: Theme.ui_font; }
                Text { text: "This resets config.json to defaults and signs you out."; color: Theme.text_dim; font-size: 12px; font-family: Theme.ui_font; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Rectangle { horizontal-stretch: 1; }
                    ButtonChip { label: "Cancel"; clicked => { root.local_data_cancel_clear(); } }
                    ButtonChip { label: "Confirm"; danger: true; clicked => { root.local_data_confirm_clear(); } }
                }
            }
        }
    }
}
