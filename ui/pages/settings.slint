import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SidebarSectionButton, ButtonChip, TextFieldBox, StatusBadge } from "../components/primitives.slint";
import { Icon } from "../components/icons.slint";

component SettingsHead inherits VerticalLayout {
    in property <string> title;
    in property <string> description;

    spacing: 6px;

    Text {
        text: root.title;
        color: Theme.text;
        font-size: 22px;
        font-weight: 600;
        font-family: Theme.ui_font;
    }

    Text {
        text: root.description;
        color: Theme.text_dim;
        font-size: 13px;
        font-family: Theme.ui_font;
        wrap: word-wrap;
    }
}

component CardHeader inherits Rectangle {
    in property <string> title;
    in property <string> description;

    height: layout.preferred-height;
    background: transparent;

    layout := VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 4px;

        if (root.title != "") : Text {
            text: root.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            font-family: Theme.ui_font;
        }

        if (root.description != "") : Text {
            text: root.description;
            color: Theme.text_dim;
            font-size: 12px;
            font-family: Theme.ui_font;
            wrap: word-wrap;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> show_divider: true;

    height: layout.preferred-height;
    background: transparent;

    layout := HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 24px;

        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            alignment: center;

            Text {
                text: root.label;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 500;
                font-family: Theme.ui_font;
            }

            if (root.hint != "") : Text {
                text: root.hint;
                color: Theme.text_mute;
                font-size: 11.5px;
                font-family: Theme.ui_font;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: end;
            @children
        }
    }

    if (root.show_divider) : Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

component InfoBanner inherits Rectangle {
    in property <string> title;
    in property <string> body;

    height: body-layout.preferred-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: #fbbf2433;
    background: #fbbf2410;

    body-layout := VerticalLayout {
        width: parent.width;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 6px;

        Text {
            text: root.title;
            color: Theme.warning;
            font-size: 11.5px;
            font-weight: 600;
            font-family: Theme.ui_font;
        }

        Text {
            text: root.body;
            color: Theme.warning;
            font-size: 11.5px;
            font-family: Theme.ui_font;
            wrap: word-wrap;
        }
    }
}

component SectionContainer inherits VerticalLayout {
    spacing: 16px;
    padding-top: 32px;
    padding-bottom: 40px;
    padding-left: 44px;
    padding-right: 44px;
}

component DataRow inherits Rectangle {
    in property <string> name;
    in property <string> desc;
    in property <string> path;
    in property <bool> last: false;

    height: row-layout.preferred-height;
    background: transparent;

    row-layout := HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 20px;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;

            Text {
                text: root.name;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 500;
                font-family: Theme.ui_font;
            }

            Text {
                text: root.desc;
                color: Theme.text_dim;
                font-size: 11.5px;
                font-family: Theme.ui_font;
                wrap: word-wrap;
            }

            Text {
                text: root.path;
                color: Theme.text_mute;
                font-size: 10.5px;
                font-family: Theme.mono_font;
            }
        }

        VerticalLayout {
            alignment: start;
            ButtonChip { label: "Clear"; icon_name: "trash"; danger: true; }
        }
    }

    if (!root.last) : Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

export component SettingsPage inherits Rectangle {
    in-out property <int> section: 0;

    background: Theme.bg;

    sidebar := Rectangle {
        x: 0px;
        y: 0px;
        width: 240px;
        height: parent.height;
        background: Theme.bg;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            height: parent.height;
            background: Theme.border;
        }

        VerticalLayout {
            x: 16px;
            y: 0px;
            width: parent.width - 32px;
            height: parent.height;
            spacing: 0px;
            padding-top: 28px;
            padding-bottom: 20px;

            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-bottom: 16px;
                spacing: 3px;

                Text {
                    text: "Settings";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 600;
                    font-family: Theme.ui_font;
                }

                Text {
                    text: "Version 1.0.0 · Build 248";
                    color: Theme.text_mute;
                    font-size: 11.5px;
                    font-family: Theme.ui_font;
                }
            }

            Rectangle { height: 1px; background: Theme.border; }

            Rectangle { height: 12px; }

            SidebarSectionButton {
                label: "Configuration";
                subtitle: "API keys & credentials";
                icon_name: "settings";
                active: root.section == 0;
                clicked => { root.section = 0; }
            }

            Rectangle { height: 2px; }

            SidebarSectionButton {
                label: "Watch Sync";
                subtitle: "Status & shared profiles";
                icon_name: "refresh";
                active: root.section == 1;
                clicked => { root.section = 1; }
            }

            Rectangle { height: 2px; }

            SidebarSectionButton {
                label: "MPV Player";
                subtitle: "Playback paths";
                icon_name: "play";
                active: root.section == 2;
                clicked => { root.section = 2; }
            }

            Rectangle { height: 2px; }

            SidebarSectionButton {
                label: "Local Data";
                subtitle: "Caches & stores";
                icon_name: "document";
                active: root.section == 3;
                clicked => { root.section = 3; }
            }

            Rectangle { vertical-stretch: 1; }

            Rectangle {
                height: 36px;
                ButtonChip {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    label: "Reset All Settings";
                    icon_name: "refresh";
                }
            }
        }
    }

    content := ScrollView {
        x: 240px;
        y: 0px;
        width: parent.width - 240px;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, current-section.preferred-height);

        current-section := VerticalLayout {
            width: parent.width;
            spacing: 0px;
            alignment: start;

                if (root.section == 0) : config-page := SectionContainer {
                    SettingsHead {
                        title: "Configuration";
                        description: "Credentials for put.io and TMDB. These never leave your device — stored locally in the OS keychain.";
                    }

                    Rectangle { height: 8px; }

                    // put.io Client card
                    Rectangle {
                        height: putio-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        putio-card := VerticalLayout {
                            width: parent.width;
                            spacing: 0px;

                            CardHeader {
                                title: "put.io Client";
                                description: "The OAuth client that identifies PutMPV to put.io.";
                            }

                            SettingsRow {
                                label: "Client ID";
                                hint: "Default: 6275 · You can replace with your own if you've registered an app.";

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    TextFieldBox { width: 140px; value: "6275"; monospace: true; }
                                    ButtonChip { label: "Test"; }
                                }
                            }

                            SettingsRow {
                                label: "Account";
                                hint: "Signed in as chill.institute · linked Mar 12, 2026";
                                show_divider: false;

                                ButtonChip { label: "Unlink"; icon_name: "logout"; danger: true; }
                            }
                        }
                    }

                    // TMDB card
                    Rectangle {
                        height: tmdb-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        tmdb-card := VerticalLayout {
                            width: parent.width;
                            spacing: 0px;

                            CardHeader {
                                title: "TMDB Metadata";
                                description: "Required for movie and TV show metadata. Get your API key at themoviedb.org.";
                            }

                            SettingsRow {
                                label: "Local Key";
                                hint: "Stored on this device only. Used as a fallback when no shared key is available.";

                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    TextFieldBox { width: 280px; placeholder: "Enter your TMDB key…"; monospace: true; }
                                    HorizontalLayout {
                                        alignment: end;
                                        ButtonChip { label: "Save local"; primary: true; }
                                    }
                                }
                            }

                            SettingsRow {
                                label: "put.io Shared Key";
                                hint: "Pulled from your put.io account — accessible on every device you sign in from.";
                                show_divider: false;

                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    TextFieldBox { width: 280px; value: "••••••••••••••••••••••••"; monospace: true; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: end;
                                        ButtonChip { label: "Replace on put.io"; icon_name: "arrow-up"; primary: true; }
                                        ButtonChip { label: "Delete"; icon_name: "trash"; danger: true; }
                                    }
                                }
                            }
                        }
                    }
                }

                if (root.section == 1) : sync-page := SectionContainer {
                    SettingsHead {
                        title: "Watch Status Sync";
                        description: "Sync watched file state through a shared PutMPV folder on put.io. Local changes push in the background; remote updates apply while browsing Files or Media.";
                    }

                    Rectangle { height: 8px; }

                    // Played counts
                    Rectangle {
                        height: played-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        played-card := VerticalLayout {
                            spacing: 0px;

                            CardHeader {
                                title: "Played counts";
                                description: "Totals for your active PutMPV profile when sync is enabled.";
                            }

                            Rectangle {
                                height: counts-row.preferred-height;
                                background: transparent;

                                counts-row := HorizontalLayout {
                                    padding-left: 22px;
                                    padding-right: 22px;
                                    padding-top: 20px;
                                    padding-bottom: 20px;
                                    spacing: 40px;
                                    alignment: start;

                                    VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "READ · WATCHED";
                                            color: Theme.text_mute;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            letter-spacing: 1.3px;
                                            font-family: Theme.ui_font;
                                        }
                                        Text {
                                            text: "92";
                                            color: Theme.text;
                                            font-size: 30px;
                                            font-family: Theme.mono_font;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: "KNOWN · WATCHED";
                                            color: Theme.text_mute;
                                            font-size: 10.5px;
                                            font-weight: 600;
                                            letter-spacing: 1.3px;
                                            font-family: Theme.ui_font;
                                        }
                                        Text {
                                            text: "92";
                                            color: Theme.text;
                                            font-size: 30px;
                                            font-family: Theme.mono_font;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; background: transparent; }

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: "Active profile";
                                            color: Theme.text_mute;
                                            font-size: 11px;
                                            font-family: Theme.ui_font;
                                            horizontal-alignment: right;
                                        }
                                        Text {
                                            text: "xora";
                                            color: Theme.text;
                                            font-size: 13.5px;
                                            font-weight: 600;
                                            font-family: Theme.ui_font;
                                            horizontal-alignment: right;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Profiles
                    Rectangle {
                        height: profile-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        profile-card := VerticalLayout {
                            spacing: 0px;

                            CardHeader {
                                title: "Profiles";
                                description: "Pick or create a shared profile. The first time you select a profile, local and remote file state are merged together.";
                            }

                            SettingsRow {
                                label: "Existing shared profiles";
                                hint: "6 profiles discovered on put.io";

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    TextFieldBox { width: 220px; value: "xora (92)"; }
                                    ButtonChip { label: "Use existing"; primary: true; }
                                }
                            }

                            SettingsRow {
                                label: "Create or use by name";
                                hint: "A new profile is created on put.io if the name doesn't exist.";

                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    TextFieldBox { width: 220px; value: "xora"; }
                                    ButtonChip { label: "Use / create profile"; primary: true; }
                                }
                            }

                            Rectangle {
                                height: 60px;
                                background: transparent;
                                HorizontalLayout {
                                    x: 22px;
                                    y: 14px;
                                    width: parent.width - 44px;
                                    spacing: 8px;
                                    alignment: start;
                                    ButtonChip { label: "Sync now"; icon_name: "refresh"; }
                                    ButtonChip { label: "Disable sync"; icon_name: "close"; danger: true; }
                                }
                            }
                        }
                    }
                }

                if (root.section == 2) : player-page := SectionContainer {
                    SettingsHead {
                        title: "MPV Player";
                        description: "Installation path and source used for local playback. Pick System (PATH lookup), a specific binary, or let PutMPV manage an install.";
                    }

                    Rectangle { height: 8px; }

                    Rectangle {
                        height: active-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        active-card := VerticalLayout {
                            spacing: 0px;
                            SettingsRow {
                                label: "Active MPV path";
                                hint: "/usr/bin/mpv";
                                show_divider: false;

                                StatusBadge { label: "Ready"; positive: true; }
                            }
                        }
                    }

                    Rectangle {
                        height: source-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        source-card := VerticalLayout {
                            spacing: 0px;

                            CardHeader {
                                title: "MPV Source";
                                description: "Choose how PutMPV finds mpv.";
                            }

                            SettingsRow {
                                label: "System install";
                                hint: "/usr/bin/mpv · version 0.38.0";

                                StatusBadge { label: "Available"; positive: true; }
                            }

                            SettingsRow {
                                label: "Custom path";
                                hint: "Point to a specific MPV executable.";

                                StatusBadge { label: "Available"; positive: true; }
                            }

                            SettingsRow {
                                label: "Managed install";
                                hint: "/var/lib/putmpv/mpv · version 0.39.0 (bundled)";
                                show_divider: false;

                                StatusBadge { label: "Available"; positive: true; }
                            }

                            Rectangle {
                                height: 44px;
                                background: transparent;
                                HorizontalLayout {
                                    x: 22px;
                                    y: 0px;
                                    width: parent.width - 44px;
                                    spacing: 8px;
                                    alignment: stretch;

                                    TextFieldBox {
                                        horizontal-stretch: 1;
                                        placeholder: "No custom path set";
                                        monospace: true;
                                    }
                                    ButtonChip { label: "Browse…"; icon_name: "folder"; }
                                }
                            }
                        }
                    }
                }

                if (root.section == 3) : data-page := SectionContainer {
                    SettingsHead {
                        title: "Local Data & Configuration";
                        description: "Filesystem paths for each JSON store. Clear caches or reset app configuration independently.";
                    }

                    Rectangle { height: 8px; }

                    Rectangle {
                        height: data-card.preferred-height;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.surface;
                        clip: true;

                        data-card := VerticalLayout {
                            spacing: 0px;

                            DataRow {
                                name: "App configuration";
                                desc: "OAuth token, TMDB keys, MPV path and source, put.io client ID (if set)";
                                path: "~/.config/putmpv/config.json";
                            }
                            DataRow {
                                name: "Played file state";
                                desc: "Local file store for played markers. Clearing resets played flags while keeping remote. If shared watch sync is enabled, the store is pushed to the selected put.io profile.";
                                path: "~/.config/putmpv/_state.json";
                            }
                            DataRow {
                                name: "Files data";
                                desc: "Cached directory tree and file information.";
                                path: "~/.config/putmpv/files.json";
                            }
                            DataRow {
                                name: "Matched data";
                                desc: "File to movie/TV show ID mappings.";
                                path: "~/.config/putmpv/matches.json";
                            }
                            DataRow {
                                name: "TMDB data";
                                desc: "Cached movie and TV show metadata.";
                                path: "~/.config/putmpv/tmdb.json";
                            }
                            DataRow {
                                name: "TVMaze data";
                                desc: "Cached TV show metadata from TVMaze.";
                                path: "~/.config/putmpv/tvmaze.json";
                                last: true;
                            }
                        }
                    }

                    InfoBanner {
                        title: "Warning.";
                        body: "Clearing data cannot be undone. The application will need to rebuild caches and re-fetch metadata as needed.";
                    }
                }
            }
        }
    }
