import { PlayerSkipActions } from "../components/player/player_skip_actions.slint";
import { PlayerPlaylistItem, PlayerTrack } from "../types.slint";
import { PlayerTopBar } from "../components/player/player_top_bar.slint";
import { PlayerControlsBar } from "../components/player/player_controls_bar.slint";
import { PlayerPlaylistPanel } from "../components/player/player_playlist_panel.slint";

export component PlayerPage inherits FocusScope {
    in property <image> texture;
    in property <string> title;
    in property <bool> show_skip_buttons: true;
    in property <string> skip_label;
    in property <bool> skip_next_available: false;
    callback skip_segment();
    callback skip_next();
    in-out property <bool> paused: true;
    in-out property <float> position: 0;
    in property <float> duration: 0;
    in property <float> buffered_fraction: 0;
    in property <string> position_label: "0:00";
    in property <string> duration_label: "0:00";
    in-out property <float> volume: 80;
    in-out property <bool> muted: false;
    in property <[PlayerTrack]> subtitle_tracks;
    in property <[PlayerTrack]> subtitle_search_results;
    in property <bool> subtitle_search_busy: false;
    in property <bool> subtitle_search_available: false;
    in property <bool> subtitle_search_error: false;
    in property <string> subtitle_search_status: "";
    in property <string> subtitle_download_id: "";
    in-out property <string> selected_subtitle: "";
    in property <[PlayerTrack]> audio_tracks;
    in-out property <string> selected_audio: "";
    in property <[PlayerPlaylistItem]> playlist_items;
    in property <string> playlist_current_id: "";
    in property <bool> playlist_has_previous: false;
    in property <bool> playlist_has_next: false;
    in property <string> subtitle_text: "";
    in-out property <int> subtitle_render_mode: 0;
    in-out property <bool> fullscreen: false;
    callback close();
    callback toggle_play();
    callback seek(seconds: float);
    callback set_volume(volume: float);
    callback toggle_mute();
    callback search_subtitles();
    callback select_subtitle_result(id: string);
    callback select_subtitle(track_id: string);
    callback toggle_captions();
    callback subtitle_render_mode_changed(mode: int);
    callback select_audio(track_id: string);
    callback playlist_play(file_id: string);
    callback playlist_previous();
    callback playlist_next();
    callback toggle_fullscreen();
    callback exit_fullscreen();
    callback cursor_hidden_changed(bool);

    in-out property <bool> controls_visible: true;
    in-out property <bool> playlist_open: false;
    property <bool> cursor_hidden: !root.controls_visible && !root.playlist_open;

    changed cursor_hidden => {
        root.cursor_hidden_changed(self.cursor_hidden);
    }

    focus-on-click: true;
    focus-on-tab-navigation: false;

    init => {
        root.focus();
    }

    key-pressed(event) => {
        if (event.text == Key.LeftArrow) {
            root.reveal_controls();
            root.seek(max(0, root.position - 5));
            return accept;
        } else if (event.text == Key.RightArrow) {
            root.reveal_controls();
            root.seek(root.duration > 0 ? min(root.duration, root.position + 5) : root.position + 5);
            return accept;
        } else if (event.text == Key.UpArrow) {
            root.reveal_controls();
            root.set_volume(min(100, root.volume + 5));
            return accept;
        } else if (event.text == Key.DownArrow) {
            root.reveal_controls();
            root.set_volume(max(0, root.volume - 5));
            return accept;
        }
        reject
    }

    function reveal_controls() {
        root.controls_visible = true;
        hide-timer.restart();
    }

    hide-timer := Timer {
        interval: 3000ms;
        running: root.controls_visible && !root.playlist_open && !controls.menus_open;
        triggered => {
            if !controls.menus_open { root.controls_visible = false; }
        }
    }

    KeyBinding {
        keys: @keys(Space);
        activated => {
            root.reveal_controls();
            root.toggle_play();
        }
    }

    KeyBinding {
        keys: @keys(C);
        activated => {
            root.reveal_controls();
            root.toggle_captions();
        }
    }

    KeyBinding {
        keys: @keys(M);
        activated => {
            root.reveal_controls();
            root.toggle_mute();
        }
    }

    KeyBinding {
        keys: @keys(F);
        activated => {
            root.reveal_controls();
            root.toggle_fullscreen();
        }
    }

    KeyBinding {
        keys: @keys(Escape);
        activated => {
            root.reveal_controls();
            if (root.playlist_open) {
                root.playlist_open = false;
            } else {
                root.exit_fullscreen();
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0a0a0b;
    }

    video := Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.texture;
        image-fit: contain;
    }

    click-timer := Timer {
        interval: 250ms;
        running: false;
        triggered => {
            click-timer.running = false;
            root.focus();
            root.reveal_controls();
            controls.close_menus();
            root.toggle_play();
        }
    }

    video-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.reveal_controls();
            }
        }
        clicked => {
            click-timer.start();
        }
        double-clicked => {
            click-timer.stop();
            root.focus();
            root.reveal_controls();
            controls.close_menus();
            root.playlist_open = false;
            root.toggle_fullscreen();
        }
    }

    subtitle-box := Rectangle {
        visible: root.subtitle_render_mode == 1 && root.subtitle_text != "";
        x: max(24px, (parent.width - self.width) / 2);
        y: parent.height - controls.height - self.height - 24px;
        width: min(subtitle-content.preferred-width + 32px, parent.width - 48px);
        height: subtitle-content.preferred-height + 16px;
        border-radius: 4px;
        background: #000000bf;

        subtitle-content := Text {
            x: 16px;
            y: 8px;
            width: parent.width - 32px;
            text: root.subtitle_text;
            color: #ffffff;
            font-size: 22px;
            font-family: "Noto Sans";
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    skip-actions := PlayerSkipActions {
        visible: root.show_skip_buttons && !root.playlist_open && !controls.menus_open;
        x: max(16px, parent.width - self.width - 32px);
        y: max(16px, subtitle-box.visible
            ? subtitle-box.y - self.height - 16px
            : parent.height - controls.height - self.height - 24px);
        skip_label: root.skip_label;
        next_available: root.skip_next_available;
        skip => { root.focus(); root.skip_segment(); }
        next => { root.focus(); root.skip_next(); }
    }

    top-bar := PlayerTopBar {
        x: 0px;
        y: 0px;
        width: parent.width;
        title: root.title;
        controls_visible: root.controls_visible;
        close => { root.close(); }
    }

    controls := PlayerControlsBar {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        controls_visible: root.controls_visible;
        paused <=> root.paused;
        position <=> root.position;
        duration: root.duration;
        buffered_fraction: root.buffered_fraction;
        position_label: root.position_label;
        duration_label: root.duration_label;
        volume <=> root.volume;
        muted <=> root.muted;
        subtitle_tracks: root.subtitle_tracks;
        subtitle_search_results: root.subtitle_search_results;
        subtitle_search_busy: root.subtitle_search_busy;
        subtitle_search_available: root.subtitle_search_available;
        subtitle_search_error: root.subtitle_search_error;
        subtitle_search_status: root.subtitle_search_status;
        subtitle_download_id: root.subtitle_download_id;
        menu_max_height: min(420px, max(120px, root.height - 150px));
        search_subtitles => { root.search_subtitles(); }
        select_subtitle_result(id) => { root.select_subtitle_result(id); }
        selected_subtitle <=> root.selected_subtitle;
        audio_tracks: root.audio_tracks;
        selected_audio <=> root.selected_audio;
        subtitle_render_mode <=> root.subtitle_render_mode;
        playlist_has_previous: root.playlist_has_previous;
        playlist_has_next: root.playlist_has_next;
        toggle_play => {
            root.reveal_controls();
            root.toggle_play();
        }
        seek(seconds) => {
            root.reveal_controls();
            root.seek(seconds);
        }
        set_volume(volume) => {
            root.reveal_controls();
            root.set_volume(volume);
        }
        toggle_mute => {
            root.reveal_controls();
            root.toggle_mute();
        }
        select_subtitle(track_id) => {
            root.reveal_controls();
            root.select_subtitle(track_id);
        }
        toggle_captions => {
            root.reveal_controls();
            root.toggle_captions();
        }
        subtitle_render_mode_changed(mode) => {
            root.reveal_controls();
            root.subtitle_render_mode_changed(mode);
        }
        select_audio(track_id) => {
            root.reveal_controls();
            root.select_audio(track_id);
        }
        playlist_previous => {
            root.reveal_controls();
            root.playlist_previous();
        }
        playlist_next => {
            root.reveal_controls();
            root.playlist_next();
        }
        toggle_fullscreen => {
            root.reveal_controls();
            root.toggle_fullscreen();
        }
        playlist_open <=> root.playlist_open;
        toggle_playlist => {
            root.reveal_controls();
            root.playlist_open = !root.playlist_open;
        }
    }

    playlist-overlay := PlayerPlaylistPanel {
        open <=> root.playlist_open;
        items: root.playlist_items;
        current_id: root.playlist_current_id;
        play_item(file_id) => {
            root.playlist_play(file_id);
        }
    }

}
