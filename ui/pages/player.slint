import { PlayerPlaylistItem, PlayerTrack } from "../types.slint";
import { PlayerTopBar } from "../components/player/player_top_bar.slint";
import { PlayerControlsBar } from "../components/player/player_controls_bar.slint";
import { PlayerPlaylistPanel } from "../components/player/player_playlist_panel.slint";

export component PlayerPage inherits FocusScope {
    in property <image> texture;
    in property <string> title;
    in-out property <bool> paused: true;
    in-out property <float> position: 0;
    in property <float> duration: 0;
    in property <float> buffered_fraction: 0;
    in property <string> position_label: "0:00";
    in property <string> duration_label: "0:00";
    in-out property <float> volume: 80;
    in-out property <bool> muted: false;
    in property <[PlayerTrack]> subtitle_tracks;
    in-out property <string> selected_subtitle: "";
    in property <[PlayerTrack]> audio_tracks;
    in-out property <string> selected_audio: "";
    in property <[PlayerPlaylistItem]> playlist_items;
    in property <string> playlist_current_id: "";
    in property <string> subtitle_text: "";
    in-out property <int> subtitle_render_mode: 0;
    in-out property <bool> fullscreen: false;
    callback close();
    callback toggle_play();
    callback seek(seconds: float);
    callback set_volume(volume: float);
    callback toggle_mute();
    callback select_subtitle(track_id: string);
    callback toggle_captions();
    callback subtitle_render_mode_changed(mode: int);
    callback select_audio(track_id: string);
    callback playlist_play(file_id: string);
    callback toggle_fullscreen();
    callback exit_fullscreen();

    in-out property <bool> controls_visible: true;
    in-out property <bool> playlist_open: false;

    focus-on-click: true;
    focus-on-tab-navigation: false;

    key-pressed(event) => {
        if (event.text == Key.LeftArrow) {
            root.reveal_controls();
            root.seek(max(0, root.position - 5));
            return accept;
        } else if (event.text == Key.RightArrow) {
            root.reveal_controls();
            root.seek(root.duration > 0 ? min(root.duration, root.position + 5) : root.position + 5);
            return accept;
        } else if (event.text == Key.UpArrow) {
            root.reveal_controls();
            root.set_volume(min(100, root.volume + 5));
            return accept;
        } else if (event.text == Key.DownArrow) {
            root.reveal_controls();
            root.set_volume(max(0, root.volume - 5));
            return accept;
        }
        reject
    }

    function reveal_controls() {
        root.controls_visible = true;
        hide-timer.restart();
    }

    hide-timer := Timer {
        interval: 3000ms;
        running: root.controls_visible && !root.playlist_open;
        triggered => {
            root.controls_visible = false;
        }
    }

    KeyBinding {
        keys: @keys(Space);
        activated => {
            root.reveal_controls();
            root.toggle_play();
        }
    }

    KeyBinding {
        keys: @keys(C);
        activated => {
            root.reveal_controls();
            root.toggle_captions();
        }
    }

    KeyBinding {
        keys: @keys(M);
        activated => {
            root.reveal_controls();
            root.toggle_mute();
        }
    }

    KeyBinding {
        keys: @keys(F);
        activated => {
            root.reveal_controls();
            root.toggle_fullscreen();
        }
    }

    KeyBinding {
        keys: @keys(Escape);
        activated => {
            root.reveal_controls();
            if (root.playlist_open) {
                root.playlist_open = false;
            } else {
                root.exit_fullscreen();
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #0a0a0b;
    }

    video := Image {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        source: root.texture;
        image-fit: contain;
    }

    video-touch := TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.controls_visible ? default : none;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.reveal_controls();
            }
        }
        clicked => {
            root.reveal_controls();
            controls.close_menus();
            root.playlist_open = false;
        }
    }

    if (root.subtitle_render_mode == 1 && root.subtitle_text != "") : subtitle-box := Rectangle {
        x: max(24px, (parent.width - self.width) / 2);
        y: parent.height - controls.height - self.height - 24px;
        width: min(subtitle-content.preferred-width + 32px, parent.width - 48px);
        height: subtitle-content.preferred-height + 16px;
        border-radius: 4px;
        background: #000000bf;

        subtitle-content := Text {
            x: 16px;
            y: 8px;
            width: parent.width - 32px;
            text: root.subtitle_text;
            color: #ffffff;
            font-size: 22px;
            font-family: "Noto Sans";
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    top-bar := PlayerTopBar {
        x: 0px;
        y: 0px;
        width: parent.width;
        title: root.title;
        controls_visible: root.controls_visible;
        close => { root.close(); }
    }

    controls := PlayerControlsBar {
        x: 0px;
        y: parent.height - self.height;
        width: parent.width;
        controls_visible: root.controls_visible;
        paused <=> root.paused;
        position <=> root.position;
        duration: root.duration;
        buffered_fraction: root.buffered_fraction;
        position_label: root.position_label;
        duration_label: root.duration_label;
        volume <=> root.volume;
        muted <=> root.muted;
        subtitle_tracks: root.subtitle_tracks;
        selected_subtitle <=> root.selected_subtitle;
        audio_tracks: root.audio_tracks;
        selected_audio <=> root.selected_audio;
        subtitle_render_mode <=> root.subtitle_render_mode;
        toggle_play => {
            root.reveal_controls();
            root.toggle_play();
        }
        seek(seconds) => {
            root.reveal_controls();
            root.seek(seconds);
        }
        set_volume(volume) => {
            root.reveal_controls();
            root.set_volume(volume);
        }
        toggle_mute => {
            root.reveal_controls();
            root.toggle_mute();
        }
        select_subtitle(track_id) => {
            root.reveal_controls();
            root.select_subtitle(track_id);
        }
        toggle_captions => {
            root.reveal_controls();
            root.toggle_captions();
        }
        subtitle_render_mode_changed(mode) => {
            root.reveal_controls();
            root.subtitle_render_mode_changed(mode);
        }
        select_audio(track_id) => {
            root.reveal_controls();
            root.select_audio(track_id);
        }
        toggle_fullscreen => {
            root.reveal_controls();
            root.toggle_fullscreen();
        }
        playlist_open <=> root.playlist_open;
        toggle_playlist => {
            root.reveal_controls();
            root.playlist_open = !root.playlist_open;
        }
    }

    playlist-overlay := PlayerPlaylistPanel {
        open <=> root.playlist_open;
        items: root.playlist_items;
        current_id: root.playlist_current_id;
        play_item(file_id) => {
            root.playlist_play(file_id);
        }
    }
}
