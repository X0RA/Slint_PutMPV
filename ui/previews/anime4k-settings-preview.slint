import { Anime4kSettings } from "../components/player/anime4k-settings.slint";
import { PlaybackSettingsStyle, SettingsButton } from "../components/player/player-settings-controls.slint";

export component Anime4kSettingsPreview inherits Window {
    title: "Anime4K settings preview";
    preferred-width: 380px;
    preferred-height: 440px;
    min-width: 300px;
    background: PlaybackSettingsStyle.panel;
    // 0 off, 1 waiting, 2 enabled, 3 dropped frames, 4 shader failure, 5 incompatible graphics.
    in-out property <int> scenario: 0;
    in-out property <bool> enabled: root.scenario != 0;
    in-out property <int> mode: 0;
    in-out property <bool> hq: false;
    changed scenario => { root.enabled = root.scenario != 0; }
    VerticalLayout {
        padding: 20px; spacing: 12px; alignment: start;
        HorizontalLayout {
            height: 32px; spacing: 6px;
            for name[index] in ["Off", "Waiting", "Enabled"] : SettingsButton {
                text: name; horizontal-stretch: 1; selected: root.scenario == index;
                label: "Preview " + name; clicked => { root.scenario = index; }
            }
        }
        HorizontalLayout {
            height: 32px; spacing: 6px;
            for name[index] in ["Drops", "Error", "Unavailable"] : SettingsButton {
                text: name; horizontal-stretch: 1; selected: root.scenario == index + 3;
                label: "Preview " + name; clicked => { root.scenario = index + 3; }
            }
        }
        Anime4kSettings {
            enabled: root.enabled; mode: root.mode; hq: root.hq;
            status: root.scenario == 1 ? "Starts when a video plays" : root.scenario == 2 ? "On" : root.scenario == 3 ? "Playback is stuttering. Try Lightweight or Standard, or turn off some extras." : root.scenario == 4 ? "A video effect failed to load. Try turning off an enhancement, or any custom shaders you have added." : root.scenario == 5 ? "Anime4K can't run with your graphics driver right now, so it is paused. Your choice is saved and will work again when the driver allows it." : "";
            warning: root.scenario >= 3;
            toggled(value) => { root.enabled = value; }
            mode_changed(value) => { root.mode = value; }
            quality_changed(value) => { root.hq = value; }
        }
    }
}
