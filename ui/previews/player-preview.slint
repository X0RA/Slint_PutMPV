import { MockPlayerSettings } from "./player-settings-mock.slint";
import { Theme } from "../theme.slint";
import { PlayerPage } from "../pages/player.slint";
import { PlayerTrack } from "../types.slint";
import { Switch } from "std-widgets.slint";

export component PlayerPreview inherits Window {
    title: "Player preview";
    in-out property <float> playback_position: 120;
    in-out property <bool> paused: true;
    in-out property <bool> show_skip_buttons: true;
    preferred-width: 900px;
    preferred-height: 600px;
    background: #101014;
    default-font-family: Theme.ui_font;
    in-out property <bool> searching: false;
    in-out property <bool> searched: false;
    in-out property <bool> loaded: false;
    in-out property <string> selected: "";
    in-out property <int> mode: 0;
    private property <[PlayerTrack]> loaded_tracks: [
        { id: "", name: "Off", detail: "" },
        { id: "1", name: "Example.Show.S01E07.WEB-DL.srt", detail: "eng · subrip" }
    ];
    private property <[PlayerTrack]> off_tracks: [{ id: "", name: "Off", detail: "" }];
    private property <[PlayerTrack]> results: [
        { id: "one", name: "Example.Show.S01E07.WEB-DL.srt", detail: "English · put.io · OpenSubtitles" },
        { id: "two", name: "Example.Show.S01E07.720p.HDTV.srt", detail: "English · BSPlayer · File match" }
    ];
    Text {
        x: 20px; y: 10px; width: parent.width - 250px; height: 24px;
        text: (root.paused ? "Paused" : "Playing") + " · Selected track: " + (root.selected == "" ? "Off" : root.selected) + " · Renderer: " + (root.mode == 0 ? "MPV" : "App");
        color: Theme.text_dim;
    }
    Switch {
        x: parent.width - self.width - 20px; y: 8px;
        text: "Show skip buttons";
        checked <=> root.show_skip_buttons;
    }
    Timer {
        interval: 1s;
        running: root.searching;
        triggered => { root.searching = false; root.searched = true; }
    }
    PlayerPage {
        settings_values: MockPlayerSettings.values;
        settings_flush => { true }
        setting_number(key, value) => { MockPlayerSettings.number(key, value); }
        setting_text(key, value) => { MockPlayerSettings.text(key, value); }
        setting_flag(key, value) => { MockPlayerSettings.flag(key, value); }
        setting_preset(value) => { MockPlayerSettings.preset(value); }
        settings_lock(section) => { MockPlayerSettings.lock(section); }
        settings_reset(section) => { MockPlayerSettings.reset(section); }
        y: 42px; width: parent.width; height: parent.height - 42px;
        title: "Example Show · S01E07";
        show_skip_buttons: root.show_skip_buttons;
        duration: 2400; duration_label: "40:00";
        position: root.playback_position; position_label: "" + root.playback_position;
        skip_label: root.playback_position >= 120 && root.playback_position < 210 ? "Skip intro" : "";
        skip_next_available: root.playback_position >= 2300;
        skip_segment => { root.playback_position = 210; }
        skip_next => { root.playback_position = 0; }
        seek(seconds) => { root.playback_position = seconds; }
        paused <=> root.paused;
        toggle_play => { root.paused = !root.paused; }
        subtitle_tracks: root.loaded ? root.loaded_tracks : root.off_tracks;
        selected_subtitle <=> root.selected;
        subtitle_render_mode <=> root.mode;
        subtitle_text: root.selected == "" ? "" : "This is a downloaded subtitle.";
        subtitle_search_available: true;
        subtitle_search_busy: root.searching;
        subtitle_search_results: root.searched ? root.results : [];
        subtitle_search_status: root.searching ? "Searching put.io…" : root.loaded ? "Subtitle loaded." : "";
        search_subtitles => { root.searching = true; root.searched = false; }
        select_subtitle_result(id) => { root.loaded = true; root.selected = "1"; }
    }
}
