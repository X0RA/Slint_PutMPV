import { Theme } from "../theme.slint";
import { Icon } from "./icons.slint";

export component TopNavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon_name;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: 7px;
    background: active ? Theme.accent_soft : transparent;
    width: label-text.preferred-width + 42px;

    states [
        hover when touch.has-hover : {
            background: active ? Theme.accent_soft : #ffffff08;
        }
    ]

    Icon {
        x: 12px;
        y: (parent.height - self.height) / 2;
        name: root.icon_name;
        icon_size: 14px;
        tint: root.active ? Theme.accent_hi : Theme.text_dim;
    }

    label-text := Text {
        x: 32px;
        y: (parent.height - self.height) / 2 + 1px;
        text: root.label;
        color: root.active ? Theme.accent_hi : Theme.text_dim;
        font-size: 12.5px;
        font-weight: 500;
        font-family: Theme.ui_font;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component ButtonChip inherits Rectangle {
    in property <string> label;
    in property <string> icon_name: "";
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    opacity: enabled ? 1 : 0.45;
    border-color: primary ? transparent : (danger ? #f871714d : (active ? Theme.accent_border : Theme.border));
    background: primary ? Theme.accent : (active ? Theme.accent_soft : Theme.surface);
    width: root.label == "" && root.icon_name != "" ? 32px : label-text.preferred-width + (icon_name == "" ? 22px : 40px);

    states [
        hover when root.enabled && touch.has-hover : {
            background: primary ? Theme.accent_hi : (active ? Theme.accent_soft : Theme.surface_hi);
        }
    ]

    if (root.icon_name != "") : icon := Icon {
        x: root.label == "" ? (parent.width - self.width) / 2 : 10px;
        y: (parent.height - self.height) / 2;
        name: root.icon_name;
        icon_size: 12px;
        tint: root.primary ? Theme.bg : (root.danger ? Theme.danger : (root.active ? Theme.accent_hi : Theme.text_dim));
    }

    label-text := Text {
        x: root.icon_name == "" ? 11px : 28px;
        y: (parent.height - self.height) / 2 + 1px;
        text: root.label;
        color: root.primary ? Theme.bg : (root.danger ? Theme.danger : (root.active ? Theme.accent_hi : Theme.text_dim));
        font-size: 12px;
        font-weight: root.primary ? 600 : 500;
        font-family: Theme.ui_font;
    }

    touch := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

/// Toolbar segment for conjoined pill groups (flush, no gaps; use inside a clipped rounded parent).
export component SegmentChip inherits Rectangle {
    in property <string> label;
    in property <string> icon_name: "";
    in property <bool> active: false;
    in property <bool> show_right_divider: true;
    callback clicked();

    vertical-stretch: 1;
    border-width: 0px;
    border-radius: 0px;
    background: active ? Theme.accent_soft : transparent;

    if (show_right_divider) : Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    states [
        hover when touch.has-hover && !active : {
            background: #ffffff08;
        }
        hover when touch.has-hover && active : {
            background: Theme.accent_soft;
        }
    ]

    if (root.icon_name == "") : Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.accent_hi : Theme.text_dim;
        font-size: 12px;
        font-weight: 500;
        font-family: Theme.ui_font;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if (root.icon_name != "") : HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 14px;
            vertical-stretch: 1;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.icon_name;
                icon_size: 12px;
                tint: root.active ? Theme.accent_hi : Theme.text_dim;
            }
        }

        Text {
            vertical-stretch: 1;
            text: root.label;
            color: root.active ? Theme.accent_hi : Theme.text_dim;
            font-size: 12px;
            font-weight: 500;
            font-family: Theme.ui_font;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon_name;
    in property <brush> tint: Theme.text_mute;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: transparent;

    states [
        hover when touch.has-hover : {
            background: #ffffff08;
        }
    ]

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon_name;
        icon_size: 14px;
        tint: root.tint;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SearchField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <string> shortcut: "";
    callback edited();

    height: 38px;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    Icon {
        x: 12px;
        y: (parent.height - self.height) / 2;
        name: "search";
        icon_size: 13px;
        tint: Theme.text_mute;
    }

    TextInput {
        x: 34px;
        y: 0px;
        width: parent.width - (root.shortcut == "" ? 44px : 76px);
        height: parent.height;
        text <=> root.text;
        font-size: 12.5px;
        font-family: Theme.ui_font;
        color: Theme.text;
        selection-foreground-color: Theme.bg;
        selection-background-color: Theme.accent;
        vertical-alignment: center;
        changed text => { root.edited(); }
    }

    if (root.text == "") : placeholder-text := Text {
        x: 34px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text_mute;
        font-size: 12.5px;
        font-family: Theme.ui_font;
    }

    if (root.shortcut != "") : shortcut-badge := Rectangle {
        width: shortcut-text.preferred-width + 10px;
        height: 18px;
        x: parent.width - self.width - 10px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
        background: transparent;

        shortcut-text := Text {
            text: root.shortcut;
            color: Theme.text_mute;
            font-size: 10.5px;
            font-family: Theme.mono_font;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component TextFieldBox inherits Rectangle {
    in-out property <string> text: "";
    in property <string> value: "";
    in property <string> placeholder: "";
    in property <bool> monospace: false;
    in property <bool> masked: false;
    in property <bool> read_only: false;
    callback edited();

    height: 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg;

    TextInput {
        x: 11px;
        y: 0px;
        width: parent.width - 22px;
        height: parent.height;
        text: root.value != "" ? root.value : root.text;
        color: (root.value != "" || root.text != "") ? Theme.text : Theme.text_mute;
        font-size: 12px;
        font-family: root.monospace ? Theme.mono_font : Theme.ui_font;
        selection-foreground-color: Theme.bg;
        selection-background-color: Theme.accent;
        vertical-alignment: center;
        enabled: !root.read_only && root.value == "";
        changed text => {
            if (root.value == "") {
                root.text = self.text;
                root.edited();
            }
        }
    }

    if (root.value == "" && root.text == "") : placeholder-text := Text {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 22px;
        text: root.placeholder;
        color: Theme.text_mute;
        font-size: 12px;
        font-family: root.monospace ? Theme.mono_font : Theme.ui_font;
        overflow: elide;
    }
}

export component RadioRow inherits Rectangle {
    in property <string> label;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    width: label-text.preferred-width + 28px;
    background: transparent;
    opacity: enabled ? 1 : 0.45;

    outer := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.checked ? Theme.accent_hi : Theme.border_hi;
        background: root.checked ? Theme.accent_soft : transparent;

        if (root.checked) : inner := Rectangle {
            width: 8px;
            height: 8px;
            x: 4px;
            y: 4px;
            border-radius: 4px;
            background: Theme.accent_hi;
        }
    }

    label-text := Text {
        x: 24px;
        y: (parent.height - self.height) / 2;
        text: root.label;
        color: root.checked ? Theme.text : Theme.text_dim;
        font-size: 12px;
        font-weight: root.checked ? 600 : 500;
        font-family: Theme.ui_font;
    }

    touch := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

export component Dropdown inherits Rectangle {
    in property <[string]> items;
    in-out property <int> selected_index: -1;
    in-out property <bool> open: false;
    in property <string> placeholder: "Select…";
    callback selected(index: int);

    height: open ? 36px + min(items.length, 5) * 30px : 36px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg;
    clip: true;

    Text {
        x: 11px;
        y: 0px;
        width: parent.width - 34px;
        height: 36px;
        text: root.selected_index >= 0 && root.selected_index < root.items.length ? root.items[root.selected_index] : root.placeholder;
        color: root.selected_index >= 0 ? Theme.text : Theme.text_mute;
        font-size: 12px;
        font-family: Theme.ui_font;
        vertical-alignment: center;
        overflow: elide;
    }

    Icon {
        x: parent.width - 23px;
        y: 11px;
        name: "chevron-down";
        icon_size: 12px;
        tint: Theme.text_mute;
    }

    TouchArea {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 36px;
        clicked => { root.open = !root.open; }
    }

    if (root.open) : VerticalLayout {
        x: 0px;
        y: 36px;
        width: parent.width;
        for item[index] in root.items : Rectangle {
            height: 30px;
            background: index == root.selected_index ? Theme.accent_soft : Theme.bg;
            Text {
                x: 11px;
                y: 0px;
                width: parent.width - 22px;
                height: parent.height;
                text: item;
                color: index == root.selected_index ? Theme.accent_hi : Theme.text_dim;
                font-size: 12px;
                font-family: Theme.ui_font;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                clicked => {
                    root.selected_index = index;
                    root.open = false;
                    root.selected(index);
                }
            }
        }
    }
}

export component DetailValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;

    height: 38px;
    background: transparent;

    Text {
        text: root.label;
        x: 0px;
        y: (parent.height - self.height) / 2;
        color: Theme.text_mute;
        font-size: 12px;
        font-family: Theme.ui_font;
    }

    Text {
        text: root.value;
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: min(self.preferred-width, parent.width * 0.62);
        color: Theme.text;
        font-size: 12px;
        font-family: root.mono ? Theme.mono_font : Theme.ui_font;
        horizontal-alignment: right;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> label;
    in property <bool> positive: false;

    height: 22px;
    border-radius: 5px;
    border-width: 1px;
    border-color: positive ? #86efac40 : #fbbf2440;
    background: positive ? #86efac14 : #fbbf2417;
    width: label-text.preferred-width + 28px;

    icon := Icon {
        x: 8px;
        y: (parent.height - self.height) / 2;
        name: positive ? "check" : "close";
        icon_size: 10px;
        tint: positive ? Theme.success : Theme.warning;
    }

    label-text := Text {
        x: 22px;
        y: 0px;
        height: parent.height;
        text: root.label;
        color: positive ? Theme.success : Theme.warning;
        font-size: 10.5px;
        font-weight: 600;
        font-family: Theme.ui_font;
        vertical-alignment: center;
    }
}

export component SidebarSectionButton inherits Rectangle {
    in property <string> label;
    in property <string> subtitle;
    in property <string> icon_name;
    in property <bool> active: false;
    callback clicked();

    height: 48px;
    border-radius: 7px;
    background: active ? Theme.accent_soft : transparent;

    states [
        hover when touch.has-hover : {
            background: active ? Theme.accent_soft : #ffffff06;
        }
    ]

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 11px;
        alignment: start;

        Rectangle {
            width: 18px;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.icon_name;
                icon_size: 14px;
                tint: root.active ? Theme.accent_hi : Theme.text_mute;
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: center;
            label-text := Text {
                text: root.label;
                color: root.active ? Theme.accent_hi : Theme.text;
                font-size: 12.5px;
                font-weight: 500;
                font-family: Theme.ui_font;
            }

            Text {
                text: root.subtitle;
                color: Theme.text_mute;
                font-size: 11px;
                font-family: Theme.ui_font;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
