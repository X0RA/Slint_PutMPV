import { Theme } from "../../theme.slint";
import { Icon } from "../icons.slint";
import { PlayerIconButton } from "./player_button.slint";

export component PlayerTopBar inherits Rectangle {
    in property <string> title;
    in property <bool> controls_visible: true;
    callback close();

    height: 64px;
    background: @linear-gradient(180deg, #000000cc 0%, #00000099 45%, #00000000 100%);
    opacity: root.controls_visible ? 1 : 0;

    animate opacity { duration: 250ms; easing: ease-out; }

    // Swallow clicks on the bar background when visible so they don't reach
    // the video-area TouchArea behind us and toggle play.
    swallow := TouchArea {
        enabled: root.controls_visible;
    }

    back := Rectangle {
        x: 16px;
        y: 12px;
        width: 68px;
        height: 30px;
        background: transparent;

        Icon {
            x: 0px;
            y: (parent.height - self.height) / 2;
            name: "chevron-left";
            icon_size: 14px;
            tint: back-touch.has-hover ? #ffffff : #8a8a8a;
        }

        Text {
            x: 17px;
            y: 0px;
            height: parent.height;
            text: "Back";
            color: back-touch.has-hover ? #ffffff : #8a8a8a;
            font-size: 12px;
            font-family: Theme.ui_font;
            vertical-alignment: center;
        }

        back-touch := TouchArea {
            clicked => { root.close(); }
        }
    }

    Text {
        x: 210px;
        y: 14px;
        width: parent.width - 420px;
        height: 22px;
        text: root.title;
        color: #a0a0a0;
        font-size: 12px;
        font-weight: 400;
        font-family: Theme.mono_font;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    PlayerIconButton {
        x: parent.width - self.width - 16px;
        y: 10px;
        icon_name: "settings";
        tone: "subtle";
        clicked => { }
    }
}
