import { Theme } from "../theme.slint";

export component LoadingSpinner inherits Rectangle {
    in property <string> label: "Loading artwork";
    width: 30px;
    height: 30px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 32;
        viewbox-height: 32;
        fill: transparent;
        stroke: Theme.accent_hi;
        stroke-width: 3px;
        commands: "M 16 3 A 13 13 0 1 1 3 16";
        transform-rotation: 360deg * mod(animation-tick(), 1s) / 1s;
    }
}
