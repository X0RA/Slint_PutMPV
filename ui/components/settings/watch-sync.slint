import { Theme } from "../../theme.slint";
import { ButtonChip, TextFieldBox, Dropdown } from "../primitives.slint";

component SettingsHead inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 6px;
    Text { text: root.title; color: Theme.text; font-size: 22px; font-weight: 600; font-family: Theme.ui_font; }
    Text { text: root.description; color: Theme.text_dim; font-size: 13px; font-family: Theme.ui_font; wrap: word-wrap; }
}

component CardHeader inherits Rectangle {
    in property <string> title;
    in property <string> description;
    height: layout.preferred-height;
    background: transparent;
    layout := VerticalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 18px;
        padding-bottom: 14px;
        spacing: 4px;
        Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; font-family: Theme.ui_font; }
        if (root.description != "") : Text { text: root.description; color: Theme.text_dim; font-size: 12px; font-family: Theme.ui_font; wrap: word-wrap; }
    }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> show_divider: true;
    height: layout.preferred-height;
    background: transparent;
    layout := HorizontalLayout {
        padding-left: 22px;
        padding-right: 22px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 24px;
        VerticalLayout {
            spacing: 3px;
            horizontal-stretch: 1;
            alignment: start;
            Text { text: root.label; color: Theme.text; font-size: 12.5px; font-weight: 500; font-family: Theme.ui_font; }
            if (root.hint != "") : Text { text: root.hint; color: Theme.text_mute; font-size: 11.5px; font-family: Theme.ui_font; wrap: word-wrap; }
        }
        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: end;
            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                @children
            }
        }
    }
    if (root.show_divider) : Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
}

component InfoBanner inherits Rectangle {
    in property <string> title;
    in property <string> body;
    height: body-layout.preferred-height;
    border-radius: 8px;
    border-width: 1px;
    border-color: #fbbf2433;
    background: #fbbf2410;
    body-layout := VerticalLayout {
        width: parent.width;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 16px;
        spacing: 6px;
        Text { text: root.title; color: Theme.warning; font-size: 11.5px; font-weight: 600; font-family: Theme.ui_font; }
        Text { text: root.body; color: Theme.warning; font-size: 11.5px; font-family: Theme.ui_font; wrap: word-wrap; }
    }
}

export component WatchSyncSettingsPanel inherits VerticalLayout {
    in property <[string]> profile_labels;
    in-out property <int> existing_index: -1;
    in-out property <bool> dropdown_open: false;
    in-out property <string> new_name;
    in property <string> status;
    in property <int> played_count: 0;
    in property <int> known_count: 0;
    in property <string> active_profile;

    callback profile_selected(index: int);
    callback use_existing();
    callback use_new();
    callback sync_now();
    callback disable_sync();

    spacing: 16px;
    padding-top: 32px;
    padding-bottom: 40px;
    padding-left: 44px;
    padding-right: 44px;

    SettingsHead { title: "Watch Status Sync"; description: "Sync watched file state through a shared PutMPV folder on put.io."; }
    Rectangle { height: 8px; }

    Rectangle {
        height: played-card.preferred-height;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        clip: true;
        played-card := VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: header-row.preferred-height;
                background: transparent;
                header-row := HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 22px;
                    padding-top: 16px;
                    padding-bottom: 16px;
                    spacing: 24px;
                    Text { text: "Watch progress"; color: Theme.text; font-size: 14px; font-weight: 600; font-family: Theme.ui_font; vertical-alignment: center; }
                    if (root.active_profile != "") : HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Syncing via"; color: Theme.text_mute; font-size: 11px; font-family: Theme.ui_font; vertical-alignment: center; }
                        Rectangle {
                            width: profile-label.preferred-width + 14px;
                            height: 20px;
                            border-radius: 5px;
                            background: Theme.accent_soft;
                            profile-label := Text { text: root.active_profile; color: Theme.accent_hi; font-size: 11px; font-weight: 500; font-family: Theme.ui_font; vertical-alignment: center; horizontal-alignment: center; }
                        }
                    }
                    if (root.active_profile != "") : Rectangle { width: 1px; height: 20px; background: Theme.border; }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: root.played_count; color: Theme.accent_hi; font-size: 17px; font-weight: 600; font-family: Theme.mono_font; vertical-alignment: center; }
                        Text { text: "watched"; color: Theme.text_mute; font-size: 11px; font-family: Theme.ui_font; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: root.known_count; color: Theme.text; font-size: 17px; font-weight: 600; font-family: Theme.mono_font; vertical-alignment: center; }
                        Text { text: "tracked"; color: Theme.text_mute; font-size: 11px; font-family: Theme.ui_font; vertical-alignment: center; }
                    }
                    if (root.known_count > 0) : Text {
                        text: Math.round(root.played_count * 100 / root.known_count) + "%";
                        color: Theme.text_mute;
                        font-size: 11px;
                        font-family: Theme.ui_font;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 12px;
                        ButtonChip { label: "Sync now"; icon_name: "refresh"; clicked => { root.sync_now(); } }
                        ButtonChip { label: "Disable"; icon_name: "close"; danger: true; clicked => { root.disable_sync(); } }
                    }
                }
                Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.border; }
            }
        }
    }
    Rectangle {
        height: profile-card.preferred-height;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        clip: false;
        profile-card := VerticalLayout {
            spacing: 0px;
            CardHeader { title: "Profiles"; description: "Pick or create a shared profile. Selecting a profile merges local and remote file state."; }
            SettingsRow {
                label: "Existing shared profiles";
                hint: root.profile_labels.length == 0 ? "No profiles discovered on put.io." : "Profiles discovered on put.io.";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Dropdown { width: 240px; items: root.profile_labels; selected_index <=> root.existing_index; open <=> root.dropdown_open; placeholder: "Select profile"; selected(index) => { root.profile_selected(index); } }
                    ButtonChip { width: new-btn.width; label: "Use existing"; primary: true; center_content: true; enabled: root.existing_index >= 0; clicked => { root.use_existing(); } }
                }
            }
            SettingsRow {
                label: "Create or use by name";
                hint: "A new profile is created on put.io if the name does not exist.";
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    TextFieldBox { width: 240px; placeholder: "Profile name"; text <=> root.new_name; }
                    new-btn := ButtonChip { label: "Use / create profile"; primary: true; center_content: true; clicked => { root.use_new(); } }
                }
            }
        }
    }
    if (root.status != "") : InfoBanner { title: "Sync"; body: root.status; }
}
